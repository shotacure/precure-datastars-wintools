<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PrecureDataStars.EpisodeLinkSync
      TV の各話の、放送後に公式から出るリンク（東映アニメーションのあらすじ・作品ラインナップの各話ページ、
      公式 YouTube チャンネルの予告）を見つけて、episodes の空の列にだけ書く内部用コンソール。
      タスクスケジューラから scripts/scheduled-episode-links.ps1 経由で動かす（登録は register-episode-links-task.ps1）。
      配布 ZIP には含めない。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>PrecureDataStars.EpisodeLinkSync</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrecureDataStars.Data\PrecureDataStars.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- App.config から接続文字列を読み出すため。 -->
    <PackageReference Include="System.Configuration.ConfigurationManager" />
  </ItemGroup>

</Project>
