<article>
  <p class="muted">
    <a href="/creators/staff/">スタッフ一覧</a>
  </p>

  <h1>{{ Person.DisplayName | html.escape }}</h1>

  {{~ if Person.DisplayNameKana != "" ~}}
  <p class="muted">{{ Person.DisplayNameKana | html.escape }}</p>
  {{~ end ~}}

  {{## サイト全体のクレジット横断カバレッジ宣言。
       ラベル文字列が空（クリーンDB等）のときは段落自体を出さない。 ##}}
  {{~ if CoverageLabel != "" ~}}
  <p class="muted stats-coverage">{{ CoverageLabel }}</p>
  {{~ end ~}}

  {{## 基本情報セクションは h1 + 直下 muted（よみ）に内容がない情報だけを出す。
       氏名・よみは上ですでに出ているので table 行に再出ししない。
       誕生日（BirthYearVisibility に応じて年抜き）・没年月日・初参加・備考がすべて空のときはセクション自体を省略する。 ##}}
  {{~ if Person.Birthday != "" || Person.DeathDate != "" || Person.FirstAppearanceHtml != "" || Person.Notes != "" ~}}
  <section id="basic-info">
    <h2>基本情報</h2>
    <div class="fact-grid">
      {{~ if Person.Birthday != "" ~}}
      <div class="fact">
        <span class="fact-label">誕生日</span>
        <span class="fact-value">{{ Person.Birthday | html.escape }}</span>
      </div>
      {{~ end ~}}
      {{## 没年月日は分かっている所まで（年だけなら見出しは「没年」）。 ##}}
      {{~ if Person.DeathDate != "" ~}}
      <div class="fact">
        <span class="fact-label">{{ Person.DeathDateLabel }}</span>
        <span class="fact-value">{{ Person.DeathDate | html.escape }}</span>
      </div>
      {{~ end ~}}
      {{## 初参加は本編クレジット（声の出演を含む）から求めた話（クレジットの収録範囲内で確定したものだけ。リンク済み HTML）。 ##}}
      {{~ if Person.FirstAppearanceHtml != "" ~}}
      <div class="fact">
        <span class="fact-label">初参加</span>
        <span class="fact-value is-wrap">{{ Person.FirstAppearanceHtml }}</span>
      </div>
      {{~ end ~}}
      {{~ if Person.Notes != "" ~}}
      <div class="fact">
        <span class="fact-label">備考</span>
        <span class="fact-value is-wrap">{{ Person.Notes | html.escape }}</span>
      </div>
      {{~ end ~}}
    </div>
  </section>
  {{~ end ~}}

  {{## クレジット一覧。
       クレジットのある名義が 2 つ以上あるとき、または 1 つでも見出しの名前と違うときは「その時の名義」単位の
       セクション（初登場順）に分け、
       各セクション内は役職別 → シリーズ単位 1 カード（カード化）。名義が 1 つ以下のときは
       役職別グループをフラットに並べる（企業・団体詳細と同じ構造・同じ意匠）。
       全話担当のときは「(全話)」マーク、部分担当のときは「(#1〜4, 8)」表記。
       声優役のときはシリーズ内の演じたキャラ名を併記する。
       役職見出しは役職統計ページへのリンクにする（無いコードは素のテキスト）。 ##}}
  {{~ if (array.size InvolvementSections) > 0 || (array.size InvolvementGroups) > 0 ~}}
  <section id="credits">
    <h2>本編クレジット
      <span class="muted role-count"><span class="count-badges">{{~ if CreditEpisodeCountTotal > 0 ~}}<span class="count-pill count-pill-tv">📺 {{ CreditEpisodeCountTotal }}</span>{{~ end ~}}{{~ if CreditMovieCountTotal > 0 ~}}<span class="count-pill count-pill-movie">🎥 {{ CreditMovieCountTotal }}</span>{{~ end ~}}</span></span>
    </h2>
    {{~ if (array.size InvolvementSections) > 0 ~}}
    {{~ for s in InvolvementSections ~}}
    <h3 class="alias-section-heading">{{ s.AliasName | html.escape }}<span class="muted alias-section-note"> 名義</span>
      <span class="muted role-count"><span class="count-badges">{{~ if s.EpisodeCount > 0 ~}}<span class="count-pill count-pill-tv">📺 {{ s.EpisodeCount }}</span>{{~ end ~}}{{~ if s.MovieCount > 0 ~}}<span class="count-pill count-pill-movie">🎥 {{ s.MovieCount }}</span>{{~ end ~}}</span></span>
    </h3>
    {{~ for g in s.Groups ~}}
    <h4 class="credit-role-heading">
      {{~ if g.RoleUrl != "" ~}}
      <a class="credit-role-link" data-role-code="{{ g.RoleCode }}" href="{{ g.RoleUrl }}">{{ g.RoleLabel | html.escape }}</a>
      {{~ else ~}}
      <span class="credit-role-link">{{ g.RoleLabel | html.escape }}</span>
      {{~ end ~}}
      <span class="muted role-count"><span class="count-badges">{{~ if g.EpisodeCount > 0 ~}}<span class="count-pill count-pill-tv">📺 {{ g.EpisodeCount }}</span>{{~ end ~}}{{~ if g.MovieCount > 0 ~}}<span class="count-pill count-pill-movie">🎥 {{ g.MovieCount }}</span>{{~ end ~}}</span></span>
    </h4>
    {{~ if (array.size g.CharacterSections) > 0 ~}}
    {{~ for cs in g.CharacterSections ~}}
    <h5 class="voice-character-heading"><a href="{{ cs.CharacterUrl }}">{{ cs.CharacterLabel | html.escape }}</a><span class="muted"> 役</span></h5>
    <ul class="credit-card-list">
      {{~ for r in cs.SeriesRows ~}}
      <li class="credit-card">
        {{## カード枠は各話内訳の開閉スイッチ（details の summary）。シリーズ詳細への遷移はシリーズ名のリンクだけが担う。
             各話を持たない行（映画など）は開閉を持たない素の枠にする。見出し部は capture で 1 回だけ組み立てて両方で使う。 ##}}
        {{~ capture card_head ~}}
            <a class="credit-card-series" href="/series/{{ r.SeriesSlug }}/">{{ r.SeriesTitle | html.escape }}</a>
            {{~ if r.SeriesStartYearLabel != "" ~}}<span class="muted series-year">({{ r.SeriesStartYearLabel }})</span>{{~ end ~}}
            {{~ if r.IsAllEpisodes ~}}
            <span class="credit-card-range muted">(全話)</span>
            {{~ else if r.RangeLabel != "" ~}}
            <span class="credit-card-range muted">({{ r.RangeLabel | html.escape }})</span>
            {{~ end ~}}
        {{~ end ~}}
        {{~ if r.Episodes.size > 0 ~}}
        {{## 担当した各話の内訳。圧縮表記（#1〜4, 8）だけでは何の話か分からず、
             当該エピソードへの導線も無いため、サブタイトル・放送日つきでリンクする。既定では閉じておく。 ##}}
        <details class="credit-card-details">
          <summary class="credit-card-head">{{ card_head }}<span class="credit-card-toggle">各話（{{ r.Episodes.size }}話）</span></summary>
          <ul class="credit-card-episodes">
            {{~ for ep in r.Episodes ~}}
            <li><a href="{{ ep.Url }}">{{ ep.Label | html.escape }}</a><span class="muted">{{ ep.OnAirLabel }}</span></li>
            {{~ end ~}}
          </ul>
        </details>
        {{~ else ~}}
        <div class="credit-card-head">{{ card_head }}</div>
        {{~ end ~}}
      </li>
      {{~ end ~}}
    </ul>
    {{~ end ~}}
    {{~ else ~}}
    <ul class="credit-card-list">
      {{~ for r in g.SeriesRows ~}}
      <li class="credit-card">
        {{## カード枠は各話内訳の開閉スイッチ（details の summary）。シリーズ詳細への遷移はシリーズ名のリンクだけが担う。
             各話を持たない行（映画など）は開閉を持たない素の枠にする。見出し部は capture で 1 回だけ組み立てて両方で使う。 ##}}
        {{~ capture card_head ~}}
            <a class="credit-card-series" href="/series/{{ r.SeriesSlug }}/">{{ r.SeriesTitle | html.escape }}</a>
            {{~ if r.SeriesStartYearLabel != "" ~}}<span class="muted series-year">({{ r.SeriesStartYearLabel }})</span>{{~ end ~}}
            {{~ if r.IsAllEpisodes ~}}
            <span class="credit-card-range muted">(全話)</span>
            {{~ else if r.RangeLabel != "" ~}}
            <span class="credit-card-range muted">({{ r.RangeLabel | html.escape }})</span>
            {{~ end ~}}
            {{~ if r.AffiliationsLabel != "" ~}}
            <span class="credit-card-affiliation muted">所属：{{ r.AffiliationsLabel | html.escape }}</span>
            {{~ end ~}}
            {{## 演じたキャラはキャラクター詳細へのリンク済み HTML なので html.escape をかけない。 ##}}
            {{~ if r.CharacterNamesHtml != "" ~}}
            <span class="credit-card-character">— {{ r.CharacterNamesHtml }}</span>
            {{~ end ~}}
        {{~ end ~}}
        {{~ if r.Episodes.size > 0 ~}}
        {{## 担当した各話の内訳。圧縮表記（#1〜4, 8）だけでは何の話か分からず、
             当該エピソードへの導線も無いため、サブタイトル・放送日つきでリンクする。既定では閉じておく。 ##}}
        <details class="credit-card-details">
          <summary class="credit-card-head">{{ card_head }}<span class="credit-card-toggle">各話（{{ r.Episodes.size }}話）</span></summary>
          <ul class="credit-card-episodes">
            {{~ for ep in r.Episodes ~}}
            <li><a href="{{ ep.Url }}">{{ ep.Label | html.escape }}</a><span class="muted">{{ ep.OnAirLabel }}</span></li>
            {{~ end ~}}
          </ul>
        </details>
        {{~ else ~}}
        <div class="credit-card-head">{{ card_head }}</div>
        {{~ end ~}}
      </li>
      {{~ end ~}}
    </ul>
    {{~ end ~}}
    {{~ end ~}}
    {{~ end ~}}
    {{~ else ~}}
    {{~ for g in InvolvementGroups ~}}
    <h3 class="credit-role-heading">
      {{~ if g.RoleUrl != "" ~}}
      <a class="credit-role-link" data-role-code="{{ g.RoleCode }}" href="{{ g.RoleUrl }}">{{ g.RoleLabel | html.escape }}</a>
      {{~ else ~}}
      <span class="credit-role-link">{{ g.RoleLabel | html.escape }}</span>
      {{~ end ~}}
      <span class="muted role-count"><span class="count-badges">{{~ if g.EpisodeCount > 0 ~}}<span class="count-pill count-pill-tv">📺 {{ g.EpisodeCount }}</span>{{~ end ~}}{{~ if g.MovieCount > 0 ~}}<span class="count-pill count-pill-movie">🎥 {{ g.MovieCount }}</span>{{~ end ~}}</span></span>
    </h3>
    {{~ if (array.size g.CharacterSections) > 0 ~}}
    {{## 声の出演で複数の役を演じている場合は「役（キャラ）」を大くくりにして、
         その配下にシリーズと話数を出す（シリーズ・映画をまたぐ役も 1 くくりに通算）。 ##}}
    {{~ for cs in g.CharacterSections ~}}
    <h4 class="voice-character-heading"><a href="{{ cs.CharacterUrl }}">{{ cs.CharacterLabel | html.escape }}</a><span class="muted"> 役</span></h4>
    <ul class="credit-card-list">
      {{~ for r in cs.SeriesRows ~}}
      <li class="credit-card">
        {{## カード枠は各話内訳の開閉スイッチ（details の summary）。シリーズ詳細への遷移はシリーズ名のリンクだけが担う。
             各話を持たない行（映画など）は開閉を持たない素の枠にする。見出し部は capture で 1 回だけ組み立てて両方で使う。 ##}}
        {{~ capture card_head ~}}
            <a class="credit-card-series" href="/series/{{ r.SeriesSlug }}/">{{ r.SeriesTitle | html.escape }}</a>
            {{~ if r.SeriesStartYearLabel != "" ~}}<span class="muted series-year">({{ r.SeriesStartYearLabel }})</span>{{~ end ~}}
            {{~ if r.IsAllEpisodes ~}}
            <span class="credit-card-range muted">(全話)</span>
            {{~ else if r.RangeLabel != "" ~}}
            <span class="credit-card-range muted">({{ r.RangeLabel | html.escape }})</span>
            {{~ end ~}}
        {{~ end ~}}
        {{~ if r.Episodes.size > 0 ~}}
        {{## 担当した各話の内訳。圧縮表記（#1〜4, 8）だけでは何の話か分からず、
             当該エピソードへの導線も無いため、サブタイトル・放送日つきでリンクする。既定では閉じておく。 ##}}
        <details class="credit-card-details">
          <summary class="credit-card-head">{{ card_head }}<span class="credit-card-toggle">各話（{{ r.Episodes.size }}話）</span></summary>
          <ul class="credit-card-episodes">
            {{~ for ep in r.Episodes ~}}
            <li><a href="{{ ep.Url }}">{{ ep.Label | html.escape }}</a><span class="muted">{{ ep.OnAirLabel }}</span></li>
            {{~ end ~}}
          </ul>
        </details>
        {{~ else ~}}
        <div class="credit-card-head">{{ card_head }}</div>
        {{~ end ~}}
      </li>
      {{~ end ~}}
    </ul>
    {{~ end ~}}
    {{~ else ~}}
    <ul class="credit-card-list">
      {{~ for r in g.SeriesRows ~}}
      <li class="credit-card">
        {{## カード枠は各話内訳の開閉スイッチ（details の summary）。シリーズ詳細への遷移はシリーズ名のリンクだけが担う。
             各話を持たない行（映画など）は開閉を持たない素の枠にする。見出し部は capture で 1 回だけ組み立てて両方で使う。 ##}}
        {{~ capture card_head ~}}
            <a class="credit-card-series" href="/series/{{ r.SeriesSlug }}/">{{ r.SeriesTitle | html.escape }}</a>
            {{~ if r.SeriesStartYearLabel != "" ~}}<span class="muted series-year">({{ r.SeriesStartYearLabel }})</span>{{~ end ~}}
            {{~ if r.IsAllEpisodes ~}}
            <span class="credit-card-range muted">(全話)</span>
            {{~ else if r.RangeLabel != "" ~}}
            <span class="credit-card-range muted">({{ r.RangeLabel | html.escape }})</span>
            {{~ end ~}}
            {{~ if r.AffiliationsLabel != "" ~}}
            {{## 所属屋号付きクレジット行の併記。
                 AffiliationsLabel は屋号名（複数あれば「、」連結）。括弧書きの形で名前と区別する。 ##}}
            <span class="credit-card-affiliation muted">所属：{{ r.AffiliationsLabel | html.escape }}</span>
            {{~ end ~}}
            {{## 演じたキャラはキャラクター詳細へのリンク済み HTML なので html.escape をかけない。 ##}}
            {{~ if r.CharacterNamesHtml != "" ~}}
            <span class="credit-card-character">— {{ r.CharacterNamesHtml }}</span>
            {{~ end ~}}
        {{~ end ~}}
        {{~ if r.Episodes.size > 0 ~}}
        {{## 担当した各話の内訳。圧縮表記（#1〜4, 8）だけでは何の話か分からず、
             当該エピソードへの導線も無いため、サブタイトル・放送日つきでリンクする。既定では閉じておく。 ##}}
        <details class="credit-card-details">
          <summary class="credit-card-head">{{ card_head }}<span class="credit-card-toggle">各話（{{ r.Episodes.size }}話）</span></summary>
          <ul class="credit-card-episodes">
            {{~ for ep in r.Episodes ~}}
            <li><a href="{{ ep.Url }}">{{ ep.Label | html.escape }}</a><span class="muted">{{ ep.OnAirLabel }}</span></li>
            {{~ end ~}}
          </ul>
        </details>
        {{~ else ~}}
        <div class="credit-card-head">{{ card_head }}</div>
        {{~ end ~}}
      </li>
      {{~ end ~}}
    </ul>
    {{~ end ~}}
    {{~ end ~}}
    {{~ end ~}}
  </section>
  {{## 本編クレジットが無くても音楽クレジットがあれば、空の本編クレジット欄は出さない（演奏者・スタッフだけの人物）。 ##}}
  {{~ else if (array.size MusicSections) == 0 ~}}
  <section id="credits">
    <h2>本編クレジット</h2>
    <p class="empty-row">この方のクレジット情報はまだ登録されていません。</p>
  </section>
  {{~ end ~}}

{{ include '_music-credits.sbn' ~}}

  {{## 代表作（プリキュアを除く）。person_notable_works の行を並び順どおりに「年 ｜ 作品 ｜ 役職」の表で出す。
       作品名は作品の公式サイトへの外部リンク。公式サイトが閉鎖済みでアーカイブへリンクする行は、
       リンクの後ろに「公式サイトのアーカイブ」と添えて、リンク先がアーカイブだと分かるようにする。
       行が無い人物には出さない。 ##}}
  {{~ if NotableWorks.size > 0 ~}}
  <section id="notable-works">
    <h2>代表作（プリキュアを除く）</h2>
    <table class="notable-works-table">
      <thead>
        <tr><th class="col-year">年</th><th class="col-title">作品</th><th class="col-role">役職</th></tr>
      </thead>
      <tbody>
        {{~ for w in NotableWorks ~}}
        <tr>
          <td class="col-year">{{ w.Period }}</td>
          <td class="col-title">
            {{~ if w.Url != "" ~}}
            <a href="{{ w.Url | html.escape }}" target="_blank" rel="noopener nofollow">{{ w.Title | html.escape }}</a>
            {{~ if w.IsArchive ~}}<span class="notable-work-archive">公式サイトのアーカイブ</span>{{~ end ~}}
            {{~ else ~}}
            {{ w.Title | html.escape }}
            {{~ end ~}}
          </td>
          <td class="col-role">{{ w.Role | html.escape }}</td>
        </tr>
        {{~ end ~}}
      </tbody>
    </table>
  </section>
  {{~ end ~}}

  {{## 外部リンクセクション。詳細ページの末尾に置く。Person.OfficialUrl / AffiliationUrl / XUrl / InstagramUrl / YoutubeUrl が
       一つでもあれば表示。公式ページは本人の公式サイト、所属先は事務所・会社・楽団などのサイトにある本人のプロフィール。
       Wikipedia は内部値として保持のみ、UI からは出さない方針なのでここでは扱わない。 ##}}
  {{~ if Person.OfficialUrl != "" || Person.AffiliationUrl != "" || Person.XUrl != "" || Person.InstagramUrl != "" || Person.YoutubeUrl != "" ~}}
  <section id="external-links">
    <h2>外部リンク</h2>
    <ul class="external-links">
      {{~ if Person.OfficialUrl != "" ~}}
      <li><a class="external-link external-link-official" href="{{ Person.OfficialUrl }}" target="_blank" rel="noopener nofollow">公式ページ</a></li>
      {{~ end ~}}
      {{~ if Person.AffiliationUrl != "" ~}}
      <li><a class="external-link external-link-affiliation" href="{{ Person.AffiliationUrl }}" target="_blank" rel="noopener nofollow">所属先</a></li>
      {{~ end ~}}
      {{~ if Person.XUrl != "" ~}}
      <li><a class="external-link external-link-x" href="{{ Person.XUrl }}" target="_blank" rel="noopener nofollow">X (Twitter)</a></li>
      {{~ end ~}}
      {{~ if Person.InstagramUrl != "" ~}}
      <li><a class="external-link external-link-instagram" href="{{ Person.InstagramUrl }}" target="_blank" rel="noopener nofollow">Instagram</a></li>
      {{~ end ~}}
      {{~ if Person.YoutubeUrl != "" ~}}
      <li><a class="external-link external-link-youtube" href="{{ Person.YoutubeUrl }}" target="_blank" rel="noopener nofollow">YouTube</a></li>
      {{~ end ~}}
    </ul>
  </section>
  {{~ end ~}}
</article>
