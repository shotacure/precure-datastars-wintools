{{## スタッフ一覧の役職順タブの役職 1 行（役職名 + 担当数）。呼び出し側のループ変数 r（RoleIndexEntry）を使う。 ##}}
<li class="entity-row">
  {{~ if (r.PersonCount > 0 || r.CompanyCount > 0) && r.RoleUrl == "" ~}}
  {{## 役職のページの無い役職（本編の一覧なら本編の役職詳細、オトナシリーズの一覧ならオトナシリーズの役職のページが無い役職）は、リンクせずに名前だけ出す。 ##}}
  <span class="entity-row-name">{{ r.RoleNameJa | html.escape }}</span>
  <span class="entity-row-count"><span class="count-badges">{{~ if r.PersonCount > 0 ~}}<span class="count-pill count-pill-person" title="人物"><svg class="count-pill-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="5" r="3"/><path d="M2 14.5a6 6 0 0 1 12 0z"/></svg>{{ r.PersonCount }}</span>{{~ end ~}}{{~ if r.CompanyCount > 0 ~}}<span class="count-pill count-pill-company" title="企業・団体"><svg class="count-pill-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M2.5 14.5V2.5h11v12zM5 5v1.6h2V5zm4 0v1.6h2V5zM5 8.4V10h2V8.4zm4 0V10h2V8.4z"/></svg>{{ r.CompanyCount }}</span>{{~ end ~}}</span></span>
  {{~ else if r.PersonCount > 0 || r.CompanyCount > 0 ~}}
  <a class="entity-row-link" href="{{ r.RoleUrl }}" aria-label="{{ r.RoleNameJa | html.escape }}"></a>
  <a class="entity-row-name" href="{{ r.RoleUrl }}">{{ r.RoleNameJa | html.escape }}</a>
  <span class="entity-row-count"><span class="count-badges">{{~ if r.PersonCount > 0 ~}}<span class="count-pill count-pill-person" title="人物"><svg class="count-pill-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="5" r="3"/><path d="M2 14.5a6 6 0 0 1 12 0z"/></svg>{{ r.PersonCount }}</span>{{~ end ~}}{{~ if r.CompanyCount > 0 ~}}<span class="count-pill count-pill-company" title="企業・団体"><svg class="count-pill-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M2.5 14.5V2.5h11v12zM5 5v1.6h2V5zm4 0v1.6h2V5zM5 8.4V10h2V8.4zm4 0V10h2V8.4z"/></svg>{{ r.CompanyCount }}</span>{{~ end ~}}</span></span>
  {{~ else ~}}
  <span class="entity-row-name muted">{{ r.RoleNameJa | html.escape }}</span>
  <span class="entity-row-count muted">—</span>
  {{~ end ~}}
</li>
