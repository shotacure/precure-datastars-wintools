<h1>歴代プリキュア声優</h1>

<p class="lead">
  <span class="muted stats-coverage">{{ CoverageLabel }}</span>
</p>

{{## 声の出演一覧。4 タブ（キャラクター順＝既定 / 五十音順 / 初出演順 / 出演回数順）と年表タブ（出演の移り変わりの線表）。
     スタッフ一覧が役職順を筆頭にしているのに合わせ、声の出演はキャラクター順を筆頭・既定にする。
     キャラクター順・初出演順はシリーズ別セクション。シリーズ名は見出しに集約し、
     表本体からはシリーズ列を出さない（全タブ共通でシリーズ列なし）。
     行粒度は (声優 × シリーズ × キャラ)。テーブル構造が同一のパネルは Scriban の
     パラメータ付き include を避けて各パネルに直接展開する（スタッフ一覧と同方針）。
     「順位」「ランキング」の語・順位列は用いない。出演話数 0 は
     シリーズ全体スコープのみのクレジット（話数 «—»）。 ##}}
<div class="creators-tabs products-tabs">
  <div class="tabs" role="tablist" aria-label="声の出演一覧の並べ替え">
    <button type="button" class="tab-btn is-active" data-tab="character"
            role="tab" aria-selected="true" aria-controls="vc-tab-panel-character">
      キャラクター別
    </button>
    {{## 五十音順タブは読み（kana）データ未整備のため一旦無効化。データが揃ったらこのコメントを外して復活させる。
    <button type="button" class="tab-btn" data-tab="kana"
            role="tab" aria-selected="false" aria-controls="vc-tab-panel-kana">
      五十音<span class="tab-sfx">順</span>
    </button>
    ##}}
    <button type="button" class="tab-btn" data-tab="debut"
            role="tab" aria-selected="false" aria-controls="vc-tab-panel-debut">
      初出演<span class="tab-sfx">順</span>
    </button>
    <button type="button" class="tab-btn" data-tab="count"
            role="tab" aria-selected="false" aria-controls="vc-tab-panel-count">
      出演回数<span class="tab-sfx">順</span>
    </button>
    {{~ if Timeline ~}}
    <button type="button" class="tab-btn" data-tab="timeline"
            role="tab" aria-selected="false" aria-controls="vc-tab-panel-timeline">
      年表
    </button>
    {{~ end ~}}
  </div>

  <div class="list-toolbar">
  {{ include '_role-timeline-media.sbn' }}
  {{## 「プリキュアを演じた方のみ」のスイッチ。全タブに効く。入れるとルート（.products-tabs）に data-precure-only を付け、
       プリキュアを演じたことがある方（行・セクションの data-precure-cast）だけを出す（site.css）。
       プリキュアはプリキュアのマスタに入っているキャラ。年表では入れている間「主な方のみ」を切って触れなくし、
       外すと元に戻す（下のインライン JS）。? は対象の範囲の吹き出し。
       段の右端に置き、出演回数順で件数の並べ替えボタンが出るときはその左に並べる（site.css）。 ##}}
  <div class="precure-only">
    <label class="rtl-switch"><input type="checkbox" class="precure-only-input"><span class="rtl-switch-ui" aria-hidden="true"></span>プリキュアを演じた方のみ</label>
    <button type="button" class="rtl-filter-help precure-only-help" aria-label="プリキュアを演じた方の範囲" aria-expanded="false">?</button>
    <div class="rtl-filter-tip precure-only-tip" role="tooltip" hidden>プリキュアを演じたことがある声優さんだけを出します。ここでいう「プリキュア」は、TVシリーズのレギュラープリキュア（シャイニールミナスおよびミルキィローズを含むプリキュアオールスターズ）ならびにキュアエコーとキュアモフルンの{{ PrecureCount }}名です。</div>
  </div>
  {{## 件数での並べ替えボタン（count-sort.js）。data-count-sort-for のリストの行を、件数バッジの種類ごとに多い順／少ない順で並べ替える。対象リストが出ているときだけ表示される。 ##}}
  <button type="button" class="count-sort-btn" data-count-sort-for="vc-count-list" hidden></button>
  </div>

  {{## ──────── キャラクター順パネル（既定・シリーズセクション） ──────── ##}}
  <div class="tab-panel is-active" id="vc-tab-panel-character"
       data-tab-panel="character" role="tabpanel">
    {{~ if (array.size CharacterSections) == 0 ~}}
    <p class="empty-row">声の出演がまだ登録されていません。</p>
    {{~ else ~}}
    {{~ for s in CharacterSections ~}}
    <section class="creators-series-section"{{ if s.HasPrecureCast }} data-precure-cast{{ end }}>
      <h2 class="creators-series-heading">
        {{~ if s.SeriesUrl != "" ~}}
        <a href="{{ s.SeriesUrl }}">{{ s.SeriesHeadingLabel | html.escape }}</a>
        {{~ else ~}}{{ s.SeriesHeadingLabel | html.escape }}{{~ end ~}}
      </h2>
      {{## キャラクター順はキャラ名を主役に置き、声優を「(CV: ○○)」のカッコ書きで添える
           （プリキュアバッジ等のサイト共通表記に合わせる）。読みがなは一覧では出さない。
           行全体クリックはキャラ詳細へ、CV の声優名だけは個別リンクで人物詳細へ。 ##}}
      <ul class="entity-list">
        {{~ for r in s.Members ~}}
        <li class="entity-row"{{ if r.IsPrecureCast }} data-precure-cast{{ end }}>
          <a class="entity-row-link" href="{{ r.CharacterUrl }}" aria-label="{{ r.CharacterName | html.escape }}"></a>
          <a class="entity-row-name" href="{{ r.CharacterUrl }}">{{ r.CharacterName | html.escape }}</a>
          <span class="entity-row-sub muted">(CV: <a href="{{ r.PersonUrl }}">{{ r.PersonName | html.escape }}</a>{{ if r.HasOtherPersons }} 他{{ end }})</span>
          <span class="entity-row-count">{{~ if r.EpisodeCount > 0 || r.MovieCount > 0 ~}}<span class="count-badges">{{~ if r.EpisodeCount > 0 ~}}<span class="count-pill count-pill-tv">📺 {{ r.EpisodeCount }}</span>{{~ end ~}}{{~ if r.MovieCount > 0 ~}}<span class="count-pill count-pill-movie">🎥 {{ r.MovieCount }}</span>{{~ end ~}}</span>{{~ else ~}}<span class="muted">—</span>{{~ end ~}}</span>
        </li>
        {{~ end ~}}
      </ul>
    </section>
    {{~ end ~}}
    {{~ end ~}}
  </div>

  {{## 五十音順パネルは読み（kana）データ未整備のため if false で一旦無効化。データが揃ったら if false を外して復活。 ##}}
  {{~ if false ~}}
  <div class="tab-panel" id="vc-tab-panel-kana"
       data-tab-panel="kana" role="tabpanel" hidden>
    {{~ if (array.size KanaRows) == 0 ~}}
    <p class="empty-row">声の出演がまだ登録されていません。</p>
    {{~ else ~}}
    {{## 読みがなは並べ替えキーとしてのみ使い、行には表示しない（一覧の方針）。 ##}}
    <ul class="entity-list">
      {{~ for r in KanaRows ~}}
      <li class="entity-row"{{ if r.IsPrecureCast }} data-precure-cast{{ end }}>
        <a class="entity-row-link" href="{{ r.PersonUrl }}" aria-label="{{ r.PersonName | html.escape }}"></a>
        <a class="entity-row-name" href="{{ r.PersonUrl }}">{{ r.PersonName | html.escape }}</a>
        <span class="entity-row-sub muted">(<a href="{{ r.CharacterUrl }}">{{ r.CharacterName | html.escape }}</a> 役)</span>
        <span class="entity-row-count">{{~ if r.EpisodeCount > 0 || r.MovieCount > 0 ~}}<span class="count-badges">{{~ if r.EpisodeCount > 0 ~}}<span class="count-pill count-pill-tv">📺 {{ r.EpisodeCount }}</span>{{~ end ~}}{{~ if r.MovieCount > 0 ~}}<span class="count-pill count-pill-movie">🎥 {{ r.MovieCount }}</span>{{~ end ~}}</span>{{~ else ~}}<span class="muted">—</span>{{~ end ~}}</span>
      </li>
      {{~ end ~}}
    </ul>
    {{~ end ~}}
  </div>
  {{~ end ~}}

  {{## ──────── 初出演順パネル（シリーズセクション） ──────── ##}}
  <div class="tab-panel" id="vc-tab-panel-debut"
       data-tab-panel="debut" role="tabpanel" hidden>
    {{~ if (array.size DebutSections) == 0 ~}}
    <p class="empty-row">声の出演がまだ登録されていません。</p>
    {{~ else ~}}
    {{~ for s in DebutSections ~}}
    <section class="creators-series-section"{{ if s.HasPrecureCast }} data-precure-cast{{ end }}>
      <h2 class="creators-series-heading">
        {{~ if s.SeriesUrl != "" ~}}
        <a href="{{ s.SeriesUrl }}">{{ s.SeriesHeadingLabel | html.escape }}</a>
        {{~ else ~}}{{ s.SeriesHeadingLabel | html.escape }}{{~ end ~}}
      </h2>
      {{## 初出演順は声優名を主役に置き、演じたキャラを「(○○ 役)」のカッコ書きで添える。
           行全体クリックは人物詳細へ、キャラ名だけは個別リンクでキャラ詳細へ。 ##}}
      <ul class="entity-list">
        {{~ for r in s.Members ~}}
        <li class="entity-row"{{ if r.IsPrecureCast }} data-precure-cast{{ end }}>
          <a class="entity-row-link" href="{{ r.PersonUrl }}" aria-label="{{ r.PersonName | html.escape }}"></a>
          <a class="entity-row-name" href="{{ r.PersonUrl }}">{{ r.PersonName | html.escape }}</a>
          <span class="entity-row-sub muted">(<a href="{{ r.CharacterUrl }}">{{ r.CharacterName | html.escape }}</a> 役)</span>
          <span class="entity-row-count">{{~ if r.EpisodeCount > 0 || r.MovieCount > 0 ~}}<span class="count-badges">{{~ if r.EpisodeCount > 0 ~}}<span class="count-pill count-pill-tv">📺 {{ r.EpisodeCount }}</span>{{~ end ~}}{{~ if r.MovieCount > 0 ~}}<span class="count-pill count-pill-movie">🎥 {{ r.MovieCount }}</span>{{~ end ~}}</span>{{~ else ~}}<span class="muted">—</span>{{~ end ~}}</span>
        </li>
        {{~ end ~}}
      </ul>
    </section>
    {{~ end ~}}
    {{~ end ~}}
  </div>

  {{## ──────── 出演回数順パネル（セクション無し） ──────── ##}}
  <div class="tab-panel" id="vc-tab-panel-count"
       data-tab-panel="count" role="tabpanel" hidden>
    {{~ if (array.size CountRows) == 0 ~}}
    <p class="empty-row">声の出演がまだ登録されていません。</p>
    {{~ else ~}}
    <ul class="entity-list" id="vc-count-list">
      {{~ for r in CountRows ~}}
      <li class="entity-row"{{ if r.IsPrecureCast }} data-precure-cast{{ end }}>
        <a class="entity-row-link" href="{{ r.PersonUrl }}" aria-label="{{ r.PersonName | html.escape }}"></a>
        <a class="entity-row-name" href="{{ r.PersonUrl }}">{{ r.PersonName | html.escape }}</a>
        <span class="entity-row-sub muted">(<a href="{{ r.CharacterUrl }}">{{ r.CharacterName | html.escape }}</a> 役{{ if r.HasOtherCharacters }} 他{{ end }})</span>
        <span class="entity-row-count">{{~ if r.EpisodeCount > 0 || r.MovieCount > 0 ~}}<span class="count-badges">{{~ if r.EpisodeCount > 0 ~}}<span class="count-pill count-pill-tv">📺 {{ r.EpisodeCount }}</span>{{~ end ~}}{{~ if r.MovieCount > 0 ~}}<span class="count-pill count-pill-movie">🎥 {{ r.MovieCount }}</span>{{~ end ~}}</span>{{~ else ~}}<span class="muted">—</span>{{~ end ~}}</span>
      </li>
      {{~ end ~}}
    </ul>
    {{~ end ~}}
  </div>

  {{## ──────── 年表パネル（出演の移り変わりの線表。中身は _role-timeline.sbn） ──────── ##}}
  {{~ if Timeline ~}}
  <div class="tab-panel" id="vc-tab-panel-timeline"
       data-tab-panel="timeline" role="tabpanel" hidden>
    {{ include '_role-timeline.sbn' }}
  </div>
  {{~ end ~}}
</div>

<script>
(function () {
  var root = document.querySelector('.creators-tabs');
  if (!root) return;
  var buttons = root.querySelectorAll('.tab-btn');
  var panels  = root.querySelectorAll('.tab-panel');
  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var key = btn.getAttribute('data-tab');
      // 年表タブだけで見せる段の部品（TV・映画の絞り込み）の出し分けに使う。
      root.setAttribute('data-active-tab', key);
      buttons.forEach(function (b) {
        var active = b.getAttribute('data-tab') === key;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      panels.forEach(function (p) {
        var active = p.getAttribute('data-tab-panel') === key;
        p.classList.toggle('is-active', active);
        if (active) { p.removeAttribute('hidden'); } else { p.setAttribute('hidden', ''); }
      });
    });
  });

  // 「プリキュアを演じた方のみ」：ルートの data-precure-only を切り替える。年表の「主な方のみ」は、入れている間は切って触れなくし
  // （プリキュアを演じた方を全員見せる）、外すと入れる前の状態に戻す。年表の横の数は role-timeline.js が数え直す（rtl-recount）。
  var box = root.querySelector('.precure-only');
  if (!box) return;
  var input = box.querySelector('.precure-only-input');
  var mains = root.querySelectorAll('.rtl-filter-input');
  var saved = [];
  function setMain(m, checked) {
    if (m.checked === checked) return;
    m.checked = checked;
    m.dispatchEvent(new Event('change', { bubbles: true }));
  }
  input.addEventListener('change', function () {
    var on = input.checked;
    if (on) { root.setAttribute('data-precure-only', ''); } else { root.removeAttribute('data-precure-only'); }
    mains.forEach(function (m, i) {
      if (on) {
        saved[i] = m.checked;
        setMain(m, false);
        m.disabled = true;
      } else {
        m.disabled = false;
        setMain(m, saved[i] !== false);
      }
    });
    document.dispatchEvent(new CustomEvent('rtl-recount'));
  });

  // 吹き出し：マウスは ? に載せている間、タップ・クリックは開閉、キーボードはフォーカスの間（年表の「主な方のみ」の ? と同じ）。
  var help = box.querySelector('.precure-only-help');
  var tip = box.querySelector('.precure-only-tip');
  var pinned = false;
  function show() { tip.hidden = false; help.setAttribute('aria-expanded', 'true'); }
  function hide() { tip.hidden = true; help.setAttribute('aria-expanded', 'false'); }
  help.addEventListener('pointerenter', function (ev) { if (ev.pointerType !== 'touch') show(); });
  help.addEventListener('pointerleave', function (ev) { if (ev.pointerType !== 'touch' && !pinned) hide(); });
  help.addEventListener('focus', show);
  help.addEventListener('blur', function () { pinned = false; hide(); });
  help.addEventListener('click', function () {
    pinned = !pinned;
    if (pinned) show(); else hide();
  });
  document.addEventListener('click', function (ev) {
    if (!box.contains(ev.target)) { pinned = false; hide(); }
  });
  document.addEventListener('keydown', function (ev) {
    if (ev.key === 'Escape') { pinned = false; hide(); }
  });
})();
</script>