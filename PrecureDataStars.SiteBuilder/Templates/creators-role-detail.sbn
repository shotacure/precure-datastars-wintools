<p class="muted">
  <a href="/creators/staff/">スタッフ</a>
</p>

<h1>{{ RoleNameJa | html.escape }}</h1>

<p class="lead">
  「{{ RoleNameJa | html.escape }}」を担当した人物・企業・団体の一覧です。
  「初参加順」「担当回数順」をタブで切り替えられます。
<br>
  <span class="muted stats-coverage">{{ CoverageLabel }}</span>
</p>

{{## 系譜でまとめた役職の「役職名の変遷」。実際にクレジットされた表記が 2 つ以上あるときは、表記ごとに
     初めてクレジットされた順に、担当数とクレジットされた作品（TV 系は話数の範囲つき）を並べる。
     表記が 1 つ以下で、系譜に別の名前だけがあるときは「歴代の役職名」を 1 行で出す。
     閲覧者向けに日本語の役職名のみ並べる（内部の役職コードは出さない方針）。 ##}}
{{~ if (array.size NameHistory) > 0 ~}}
<section id="role-name-history" class="role-name-history">
  <h2>役職名の変遷</h2>
  <ol class="role-name-history-list">
    {{~ for h in NameHistory ~}}
    <li class="role-name-history-item">
      <div class="role-name-history-head">
        <span class="role-name-history-name">{{ h.RoleNameJa | html.escape }}</span>
        <span class="count-badges">{{~ if h.EpisodeCount > 0 ~}}<span class="count-pill count-pill-tv">📺 {{ h.EpisodeCount }}</span>{{~ end ~}}{{~ if h.MovieCount > 0 ~}}<span class="count-pill count-pill-movie">🎥 {{ h.MovieCount }}</span>{{~ end ~}}</span>
      </div>
      <ul class="role-name-history-works">
        {{~ for w in h.Works ~}}
        <li><a href="{{ w.SeriesUrl }}">{{ w.SeriesTitle | html.escape }}</a><span class="muted series-year">({{ w.SeriesYearLabel }})</span>{{~ if w.EpisodeRangeLabel != "" ~}} <span class="muted role-name-history-range">{{ w.EpisodeRangeLabel | html.escape }}</span>{{~ end ~}}</li>
        {{~ end ~}}
      </ul>
    </li>
    {{~ end ~}}
  </ol>
</section>
{{~ else if (array.size AlternateNames) > 0 ~}}
<p class="muted role-aliases">
  歴代の役職名：
  {{~ for a in AlternateNames ~}}{{ a.RoleNameJa | html.escape }}{{ if for.last == false }}・{{ end }}{{~ end ~}}
</p>
{{~ end ~}}

{{## 担当の移り変わり（線表）。見出しのボタンで開閉するアコーディオン。
     畳んだ状態は文字を出さない細線だけの概観（続けて担当した期間の線、本文 4 行ぶんの高さに収める）で、
     概観を押しても開く。開くと名前・年の目盛り・担当した話の帯・映画の点の線表を全行出し、行にマウスを載せる
     （スマホは帯をタップする）と担当期間と作品ごとの担当話を出す（role-timeline.js）。
     横軸はクレジットを収録している全期間で、TV シリーズ 1 作を 1 本の帯にする。 ##}}
{{~ if Timeline ~}}
<section id="role-timeline" class="role-timeline">
  <h2 class="rtl-title">
    <button type="button" class="rtl-toggle" aria-expanded="false" aria-controls="role-timeline-body">
      <span class="rtl-toggle-label">担当の移り変わり</span>
      <span class="rtl-toggle-state" aria-hidden="true">展開する</span>
    </button>
  </h2>
  <div class="rtl-body" id="role-timeline-body">
    <button type="button" class="rtl-mini-btn" aria-label="担当の移り変わりを展開する">
      <svg class="rtl-mini" viewBox="{{ Timeline.MiniViewBox }}" preserveAspectRatio="none" style="height:{{ Timeline.MiniHeight }}px" aria-hidden="true" focusable="false">
        <path class="rtl-mini-bands" transform="scale(1 {{ Timeline.MiniHeight }})" d="{{ Timeline.MiniBandsPath }}"/>
        <path class="rtl-mini-lines" d="{{ Timeline.MiniLinesPath }}"/>
      </svg>
    </button>
    <noscript><style>.role-timeline .rtl-full { display: block; } .role-timeline .rtl-mini-btn { display: none; }</style></noscript>
    <div class="rtl-full">
      <p class="rtl-note muted">TV のオープニングにクレジットされた人物・企業・団体と、続けて 3 クール以上担当した（担当の間隔が 13 週以内でつながる期間が 39 週以上ある）人物・企業・団体を、担当を始めた順に並べています。</p>
      <ul class="rtl-legend" aria-label="凡例">
        <li><span class="rtl-key rtl-key-tv"></span>担当した話（TV）</li>
        <li><span class="rtl-key rtl-key-movie"></span>映画</li>
        <li><span class="rtl-key rtl-key-span"></span>続けて担当した期間</li>
      </ul>
      <div class="rtl{{ if Timeline.TickDensityClass != "" }} {{ Timeline.TickDensityClass }}{{ end }}">
        <div class="rtl-bands" aria-hidden="true">
          {{~ for b in Timeline.Bands ~}}<span class="rtl-band{{ if b.IsAlt }} rtl-band-alt{{ end }}" style="left:{{ b.Left }}%;width:{{ b.Width }}%"></span>{{~ end ~}}
        </div>
        <div class="rtl-axis">
          <div class="rtl-axis-track">
            {{~ for t in Timeline.Ticks ~}}
            {{~ if t.ShowLabel ~}}<a class="rtl-tick{{ if t.IsMinor }} rtl-tick-minor{{ end }}" style="left:{{ t.Left }}%" href="{{ t.SeriesUrl }}" title="{{ t.SeriesTitle | html.escape }}">{{ t.YearLabel }}</a>
            {{~ else ~}}<span class="rtl-tick" style="left:{{ t.Left }}%" aria-hidden="true"></span>
            {{~ end ~}}
            {{~ end ~}}
          </div>
        </div>
        <ol class="rtl-rows">
          {{~ for r in Timeline.Rows ~}}
          <li class="rtl-row" data-entity-type="{{ r.EntityKind }}" data-period="{{ r.PeriodLabel | html.escape }}" data-works="{{ r.WorksText | html.escape }}">
            <a class="rtl-name" href="{{ r.EntityUrl }}">{{~ if r.EntityKind == "person" ~}}<span class="rtl-badge rtl-badge-person" aria-hidden="true"><svg viewBox="0 0 16 16" width="11" height="11" fill="currentColor"><circle cx="8" cy="5" r="3"/><path d="M2 14.5a6 6 0 0 1 12 0z"/></svg></span>{{~ else ~}}<span class="rtl-badge rtl-badge-company" aria-hidden="true"><svg viewBox="0 0 16 16" width="11" height="11" fill="currentColor" fill-rule="evenodd"><path d="M2.5 14.5V2.5h11v12zM5 5v1.6h2V5zm4 0v1.6h2V5zM5 8.4V10h2V8.4zm4 0V10h2V8.4z"/></svg></span>{{~ end ~}}<span class="rtl-name-text">{{ r.EntityName | html.escape }}</span></a>
            <div class="rtl-track" aria-hidden="true">
              {{~ for m in r.Spans ~}}<span class="rtl-span" style="left:{{ m.Left }}%;width:{{ m.Width }}%"></span>{{~ end ~}}
              {{~ for m in r.Segments ~}}<span class="rtl-seg" style="left:{{ m.Left }}%;width:{{ m.Width }}%"></span>{{~ end ~}}
              {{~ for m in r.Movies ~}}<span class="rtl-movie" style="left:{{ m.Left }}%"></span>{{~ end ~}}
            </div>
          </li>
          {{~ end ~}}
        </ol>
      </div>
      <button type="button" class="rtl-collapse-btn">たたむ</button>
    </div>
  </div>
</section>
<script src="{{ asset_url "/assets/role-timeline.js" }}" defer></script>
{{~ end ~}}

{{## 役職詳細。人物・企業/団体を 1 リストに混在させ、行ごとに「個人 / 団体」バッジで区別。
     上部トグルで個人のみ・団体のみに絞れる。3 タブはテーブル構造が同一だが、
     パラメータ付き include を避けて各パネルにテーブルを直接展開する（スタッフ一覧と同方針）。
     「順位」「ランキング」の語・順位列は用いない。 ##}}
<div class="creators-root creators-tabs products-tabs" data-entity-filter="all">
  <div class="tabs" role="tablist" aria-label="役職別一覧の並べ替え">
    {{## 五十音順タブは読み（kana）データ未整備のため一旦無効化。既定タブは初参加順へ繰り上げ。
         データが揃ったらこのコメントを外し、初参加順ボタンの is-active / aria-selected を戻す。
    <button type="button" class="tab-btn is-active" data-tab="kana"
            role="tab" aria-selected="true" aria-controls="role-tab-panel-kana">
      五十音順
    </button>
    ##}}
    <button type="button" class="tab-btn is-active" data-tab="debut"
            role="tab" aria-selected="true" aria-controls="role-tab-panel-debut">
      初参加順
    </button>
    <button type="button" class="tab-btn" data-tab="count"
            role="tab" aria-selected="false" aria-controls="role-tab-panel-count">
      担当回数順
    </button>
  </div>

  {{## 個人と団体が両方あるときだけ絞り込みフィルタを出す。片方だけの役職（脚本＝個人のみ等）では無意味なので非表示。 ##}}
  <div class="list-toolbar">
  {{~ if PersonCount > 0 && CompanyCount > 0 ~}}
  <div class="entity-filter" role="group" aria-label="個人・団体で絞り込み">
    <button type="button" class="entity-filter-btn is-active" data-entity-filter-set="all">すべて</button>
    <button type="button" class="entity-filter-btn" data-entity-filter-set="person">個人のみ</button>
    <button type="button" class="entity-filter-btn" data-entity-filter-set="company">団体のみ</button>
  </div>
  {{~ end ~}}
  {{## 件数での並べ替えボタン（count-sort.js）。data-count-sort-for のリストの行を、件数バッジの種類ごとに多い順／少ない順で並べ替える。対象リストが出ているときだけ表示される。 ##}}
  <button type="button" class="count-sort-btn" data-count-sort-for="role-count-list" hidden></button>
  </div>

  {{## 五十音順パネルは読み（kana）データ未整備のため if false で一旦無効化。データが揃ったら if false を外して復活。 ##}}
  {{~ if false ~}}
  <div class="tab-panel is-active" id="role-tab-panel-kana"
       data-tab-panel="kana" role="tabpanel">
    {{~ if (array.size KanaRows) == 0 ~}}
    <p class="empty-row">この役職の担当者情報はまだ登録されていません。</p>
    {{~ else ~}}
    {{## 読みがなは並べ替えキーとしてのみ使い、行には表示しない（一覧の方針）。 ##}}
    <ul class="entity-list entity-list-grid">
      {{~ for e in KanaRows ~}}
      <li class="entity-row" data-entity-type="{{ e.EntityKind }}">
        <a class="entity-row-link" href="{{ e.EntityUrl }}" aria-label="{{ e.EntityName | html.escape }}"{{ if e.WorksTooltip != "" }} title="{{ e.WorksTooltip | html.escape }}"{{ end }}></a>
        {{~ if e.EntityKind == "person" ~}}<span class="entity-badge entity-badge-person" aria-label="個人" title="個人"><svg class="entity-badge-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="5" r="3"/><path d="M2 14.5a6 6 0 0 1 12 0z"/></svg></span>
        {{~ else ~}}<span class="entity-badge entity-badge-company" aria-label="団体" title="団体"><svg class="entity-badge-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M2.5 14.5V2.5h11v12zM5 5v1.6h2V5zm4 0v1.6h2V5zM5 8.4V10h2V8.4zm4 0V10h2V8.4z"/></svg></span>{{~ end ~}}
        <a class="entity-row-name" href="{{ e.EntityUrl }}">{{ e.EntityName | html.escape }}</a>{{~ if e.CurrentNameNote != "" ~}}<span class="entity-row-current muted">（{{ e.CurrentNameNote | html.escape }}）</span>{{~ end ~}}
        <span class="entity-row-count"><span class="count-badges">{{~ if e.EpisodeCount > 0 ~}}<span class="count-pill count-pill-tv">📺 {{ e.EpisodeCount }}</span>{{~ end ~}}{{~ if e.MovieCount > 0 ~}}<span class="count-pill count-pill-movie">🎥 {{ e.MovieCount }}</span>{{~ end ~}}</span></span>
        {{~ if e.RoleUsageNote != "" ~}}<span class="entity-row-role-usage muted">（{{ e.RoleUsageNote | html.escape }}）</span>{{~ end ~}}
      </li>
      {{~ end ~}}
    </ul>
    {{~ end ~}}
  </div>
  {{~ end ~}}

  {{## ──────── 初参加順パネル（初参加シリーズごとのセクション。五十音順無効化に伴い既定タブ） ──────── ##}}
  <div class="tab-panel is-active" id="role-tab-panel-debut"
       data-tab-panel="debut" role="tabpanel">
    {{~ if (array.size DebutSections) == 0 ~}}
    <p class="empty-row">この役職の担当者情報はまだ登録されていません。</p>
    {{~ else ~}}
    {{~ for s in DebutSections ~}}
    <section class="creators-series-section">
      <h2 class="creators-series-heading">
        {{~ if s.SeriesUrl != "" ~}}
        <a href="{{ s.SeriesUrl }}">{{ s.SeriesHeadingLabel | html.escape }}</a>
        {{~ else ~}}{{ s.SeriesHeadingLabel | html.escape }}{{~ end ~}}
      </h2>
      <ul class="entity-list entity-list-grid">
        {{~ for e in s.Members ~}}
        <li class="entity-row" data-entity-type="{{ e.EntityKind }}">
          <a class="entity-row-link" href="{{ e.EntityUrl }}" aria-label="{{ e.EntityName | html.escape }}"{{ if e.WorksTooltip != "" }} title="{{ e.WorksTooltip | html.escape }}"{{ end }}></a>
          {{~ if e.EntityKind == "person" ~}}<span class="entity-badge entity-badge-person" aria-label="個人" title="個人"><svg class="entity-badge-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="5" r="3"/><path d="M2 14.5a6 6 0 0 1 12 0z"/></svg></span>
          {{~ else ~}}<span class="entity-badge entity-badge-company" aria-label="団体" title="団体"><svg class="entity-badge-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M2.5 14.5V2.5h11v12zM5 5v1.6h2V5zm4 0v1.6h2V5zM5 8.4V10h2V8.4zm4 0V10h2V8.4z"/></svg></span>{{~ end ~}}
          <a class="entity-row-name" href="{{ e.EntityUrl }}">{{ e.EntityName | html.escape }}</a>{{~ if e.CurrentNameNote != "" ~}}<span class="entity-row-current muted">（{{ e.CurrentNameNote | html.escape }}）</span>{{~ end ~}}
          <span class="entity-row-count"><span class="count-badges">{{~ if e.EpisodeCount > 0 ~}}<span class="count-pill count-pill-tv">📺 {{ e.EpisodeCount }}</span>{{~ end ~}}{{~ if e.MovieCount > 0 ~}}<span class="count-pill count-pill-movie">🎥 {{ e.MovieCount }}</span>{{~ end ~}}</span></span>
          {{~ if e.RoleUsageNote != "" ~}}<span class="entity-row-role-usage muted">（{{ e.RoleUsageNote | html.escape }}）</span>{{~ end ~}}
        </li>
        {{~ end ~}}
      </ul>
    </section>
    {{~ end ~}}
    {{~ end ~}}
  </div>

  {{## ──────── 担当回数順パネル ──────── ##}}
  <div class="tab-panel" id="role-tab-panel-count"
       data-tab-panel="count" role="tabpanel" hidden>
    {{~ if (array.size CountRows) == 0 ~}}
    <p class="empty-row">この役職の担当者情報はまだ登録されていません。</p>
    {{~ else ~}}
    <ul class="entity-list entity-list-grid" id="role-count-list">
      {{~ for e in CountRows ~}}
      <li class="entity-row" data-entity-type="{{ e.EntityKind }}">
        <a class="entity-row-link" href="{{ e.EntityUrl }}" aria-label="{{ e.EntityName | html.escape }}"{{ if e.WorksTooltip != "" }} title="{{ e.WorksTooltip | html.escape }}"{{ end }}></a>
        {{~ if e.EntityKind == "person" ~}}<span class="entity-badge entity-badge-person" aria-label="個人" title="個人"><svg class="entity-badge-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="5" r="3"/><path d="M2 14.5a6 6 0 0 1 12 0z"/></svg></span>
        {{~ else ~}}<span class="entity-badge entity-badge-company" aria-label="団体" title="団体"><svg class="entity-badge-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M2.5 14.5V2.5h11v12zM5 5v1.6h2V5zm4 0v1.6h2V5zM5 8.4V10h2V8.4zm4 0V10h2V8.4z"/></svg></span>{{~ end ~}}
        <a class="entity-row-name" href="{{ e.EntityUrl }}">{{ e.EntityName | html.escape }}</a>{{~ if e.CurrentNameNote != "" ~}}<span class="entity-row-current muted">（{{ e.CurrentNameNote | html.escape }}）</span>{{~ end ~}}
        <span class="entity-row-count"><span class="count-badges">{{~ if e.EpisodeCount > 0 ~}}<span class="count-pill count-pill-tv">📺 {{ e.EpisodeCount }}</span>{{~ end ~}}{{~ if e.MovieCount > 0 ~}}<span class="count-pill count-pill-movie">🎥 {{ e.MovieCount }}</span>{{~ end ~}}</span></span>
        {{~ if e.RoleUsageNote != "" ~}}<span class="entity-row-role-usage muted">（{{ e.RoleUsageNote | html.escape }}）</span>{{~ end ~}}
      </li>
      {{~ end ~}}
    </ul>
    {{~ end ~}}
  </div>
</div>

<script>
(function () {
  var root = document.querySelector('.creators-tabs');
  if (!root) return;

  var buttons = root.querySelectorAll('.tab-btn');
  var panels  = root.querySelectorAll('.tab-panel');
  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var key = btn.getAttribute('data-tab');
      buttons.forEach(function (b) {
        var active = b.getAttribute('data-tab') === key;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      panels.forEach(function (p) {
        var active = p.getAttribute('data-tab-panel') === key;
        p.classList.toggle('is-active', active);
        if (active) { p.removeAttribute('hidden'); } else { p.setAttribute('hidden', ''); }
      });
    });
  });

  var filterButtons = root.querySelectorAll('.entity-filter-btn');
  filterButtons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var mode = btn.getAttribute('data-entity-filter-set');
      root.setAttribute('data-entity-filter', mode);
      filterButtons.forEach(function (b) {
        b.classList.toggle('is-active', b === btn);
      });
    });
  });
})();
</script>
