<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PrecureDataStars.TitleCharStatsRefresh
      指定したエピソードの title_text から文字統計 JSON（episodes.title_char_stats）を作り直す内部用コンソール。
      計算は Episodes の保存時と同じ共通ビルダー（TitleCharStatsBuilder）を使う。
      DB を直接直したサブタイトルの統計を、Episodes を開かずに合わせるためのもの。配布 ZIP には含めない。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>PrecureDataStars.TitleCharStatsRefresh</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrecureDataStars.Data\PrecureDataStars.Data.csproj" />
    <ProjectReference Include="..\PrecureDataStars.Data.TitleCharStatsJson\PrecureDataStars.Data.TitleCharStatsJson.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- App.config から接続文字列を読み出すため。 -->
    <PackageReference Include="System.Configuration.ConfigurationManager" />
  </ItemGroup>

</Project>
