{{## /stats/records/{cast|staff}/{most|least}/ — 1 話のクレジットの全体の順位（声の出演人数・参加スタッフ数の多い順と少ない順）。
     RecordsGenerator から { Title, Lead, Note, CoverageLabel, Rows } で渡る。Rows は StatsEpisodeRows（同率の 2 件目以降は順位が空）。
     行の組みはエピソード尺統計の順位のページと同じ。 ##}}
<section>
  <h1>{{ Title | html.escape }}</h1>
  <p class="muted page-coverage">{{ CoverageLabel }}</p>
  <p class="lead">{{ Lead | html.escape }}</p>
  <p class="muted stats-note">{{ Note | html.escape }}同点は同じ順位とし、次の順位は同点の数だけ繰り下げます。100 位が同点なら全件を載せています。</p>
</section>

<section>
  <ol class="stats-ep-list">
    {{~ for r in Rows ~}}
    <li class="stats-ep-row{{~ if !r.HasRank ~}} no-rank{{~ end ~}}">
      {{~ if r.HasRank ~}}
      <div class="stats-ep-rank">
        <span class="stats-ep-rank-no">{{ r.RankLabel }}</span>
        {{~ if r.HasValue ~}}<span class="stats-ep-rank-val">{{ r.ValueLabel }}</span>{{~ end ~}}
      </div>
      {{~ end ~}}
      <div class="stats-ep-body">
        <div class="stats-ep-series"><a href="{{ r.SeriesUrl }}">{{ r.SeriesTitle | html.escape }}</a> <span class="stats-ep-year">({{ r.SeriesStartYearLabel }})</span></div>
        <div class="stats-ep-line2">
          <span class="ep-row-no-date">
            <span class="ep-row-no">第{{ r.SeriesEpNo }}話</span>
          </span>
          <a class="stats-ep-title" href="{{ r.EpisodeUrl }}">{{ r.TitleHtml }}</a>
        </div>
      </div>
    </li>
    {{~ end ~}}
  </ol>
</section>
