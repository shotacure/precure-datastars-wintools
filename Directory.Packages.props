<Project>

  <!--
    Central Package Management（CPM）: ソリューション内の全 NuGet パッケージのバージョンを
    本ファイルで一元管理する。各 csproj の PackageReference は Include のみを書き、
    Version はここの PackageVersion が適用される（バージョン更新は本ファイルの 1 箇所を直す）。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="AWSSDK.CloudFront" Version="4.0.17.4" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.24.4" />
    <PackageVersion Include="Dapper" Version="2.1.72" />
    <PackageVersion Include="LibVLCSharp" Version="3.9.3" />
    <PackageVersion Include="LibVLCSharp.WinForms" Version="3.9.3" />
    <PackageVersion Include="Markdig" Version="1.2.0" />
    <PackageVersion Include="MeCab.DotNet" Version="1.2.0" />
    <PackageVersion Include="MySqlConnector" Version="2.5.0" />
    <PackageVersion Include="Scriban" Version="7.2.5" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.7" />
    <PackageVersion Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
  </ItemGroup>

</Project>
