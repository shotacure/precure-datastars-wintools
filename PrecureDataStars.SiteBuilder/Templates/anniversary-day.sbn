{{## 日付別の記念日ページ。AnniversaryGenerator から DayContentModel で渡る。
     放送と公開は Timeline に均して古い順で 1 本のカード列に、誕生日は別セクションのカード列にする。
     表組みではなくカード列にするのは、ホームの「今日の記念日」と同じ見え方に揃えるため
     （同じ性質の情報がサイト内で 2 通りの見え方をしない）。
     全 366 日ぶんページがあるため、出来事が 1 件も無い日は案内文だけの面になる。 ##}}
{{## 見出しは日付だけ。何の面かは下のセクション見出し（放送・公開／誕生日）が語る。
     リード文は索引と同じ 1 文に揃える（366 日ぶんどの面から入っても同じ名乗りになる）。
     出来事が 1 件も無い日だけ、面が空になる理由を続けて断る。 ##}}
<section>
  <h1>{{ DateLabel }}</h1>
  <p class="lead">歴代プリキュアの放送日・映画公開日・キャラクターとクリエーターの誕生日。エブリデイ、プリキュア。</p>
  {{~ if !HasAnything ~}}
  <p class="muted">この日付に該当する出来事は、現在のところ登録がありません。</p>
  {{~ end ~}}
</section>

{{~ if Timeline.size > 0 ~}}
<section id="events">
  <h2>放送・公開</h2>
  {{## ホームの「今日の記念日」と同じカード（白地・薄ボーダー・カード全域が 1 タップ遷移）。
       内部にアンカーを入れ子にできないため、シリーズ名等は <span> で置く。 ##}}
  <ul class="home-anniversary-list">
    {{~ for t in Timeline ~}}
    <li class="home-anniversary-card">
      <a class="home-anniversary-card-link" href="{{ t.Url }}">
        <div class="home-anniversary-card-meta">
          <span class="home-anniversary-label">{{ t.Year }}年</span>
          {{~ if t.Kind == "ep" ~}}
          <span class="home-anniversary-series">{{ t.SeriesTitle | html.escape }}</span>
          {{~ else ~}}
          <span class="home-anniversary-label anniv-label-movie">劇場公開</span>
          {{~ end ~}}
        </div>
        <div class="home-anniversary-card-main">
          <div class="ep-row">
            <div class="ep-row-main">
              <div class="ep-row-no-date">
                <span class="ep-row-no">{{ if t.Kind == "ep" }}第{{ t.EpisodeNo }}話{{ else }}公開{{ end }}</span>
                <span class="ep-row-date">{{ t.DateLabel }}</span>
              </div>
              {{## サブタイトルは組み立て済み HTML（未解禁ならガード span 込み）なのでエスケープしない。 ##}}
              <span class="ep-row-title">{{ if t.Kind == "ep" }}{{ t.TitleGuardedHtml }}{{ else }}{{ t.SeriesTitle | html.escape }}{{ end }}
                {{~ if t.IsFirstEpisode ~}}<span class="anniv-flag">初回</span>{{~ end ~}}
                {{~ if t.IsLastEpisode ~}}<span class="anniv-flag">最終回</span>{{~ end ~}}
              </span>
            </div>
          </div>
        </div>
      </a>
    </li>
    {{~ end ~}}
  </ul>
</section>
{{~ end ~}}

{{~ if CharacterBirthdays.size > 0 || PersonBirthdays.size > 0 ~}}
<section id="birthdays">
  <h2>誕生日</h2>
  <ul class="home-anniversary-list">
    {{## キャラクターはイメージカラー由来のバッジ配色をインラインで当てる
         （キャラごとに色が変わるため CSS クラスに落とせない）。 ##}}
    {{~ for b in CharacterBirthdays ~}}
    <li class="home-anniversary-card home-anniversary-card-bday">
      <a class="home-anniversary-card-link" href="{{ b.Url }}">
        <div class="home-anniversary-card-meta">
          <span class="home-anniversary-label home-anniversary-label-bday">キャラクター</span>
          {{~ if b.SeriesTitle != "" ~}}<span class="home-anniversary-series">{{ b.SeriesTitle | html.escape }}</span>{{~ end ~}}
        </div>
        <div class="home-anniversary-card-main">
          <span class="home-bday-badge{{ if b.KeyColorBackground == "" }} home-bday-badge-plain{{ end }}"
            {{~ if b.KeyColorBackground != "" }} style="background:{{ b.KeyColorBackground }};color:{{ b.KeyColorForeground }};border-color:{{ b.KeyColorBorder }}"{{ end ~}}
          >{{ b.Name | html.escape }}</span>
          {{~ if b.SubName != "" ~}}<span class="muted">{{ b.SubName | html.escape }}</span>{{~ end ~}}
        </div>
      </a>
    </li>
    {{~ end ~}}
    {{~ for b in PersonBirthdays ~}}
    <li class="home-anniversary-card home-anniversary-card-bday">
      <a class="home-anniversary-card-link" href="{{ b.Url }}">
        <div class="home-anniversary-card-meta">
          <span class="home-anniversary-label home-anniversary-label-bday">クリエーター</span>
        </div>
        <div class="home-anniversary-card-main">
          <span class="home-anniversary-person-name">{{ b.Name | html.escape }}</span>
          {{~ if b.SubName != "" ~}}<span class="muted">{{ b.SubName | html.escape }}</span>{{~ end ~}}
        </div>
      </a>
    </li>
    {{~ end ~}}
  </ul>
</section>
{{~ end ~}}

{{## 前日・翌日ナビ。全 366 日ぶんページがあるので行き止まりにならない（12/31 の翌日は 1/1 へ回る）。 ##}}
<nav class="anniv-nav" aria-label="日付ナビゲーション">
  <a class="anniv-nav-prev" href="{{ PrevUrl }}">&laquo; {{ PrevLabel }}</a>
  <a class="anniv-nav-index" href="/anniversary/">記念日カレンダー</a>
  <a class="anniv-nav-next" href="{{ NextUrl }}">{{ NextLabel }} &raquo;</a>
</nav>
