<h1>歴代プリキュア歌唱</h1>

<p class="lead">
  プリキュアの主題歌・挿入歌・キャラクターソングを歌った人々の記録。
<br>
  <span class="muted stats-coverage">{{ CoverageLabel }}</span>
</p>

{{## 歌唱。録音の歌唱者（song_recording_singers）を、歌・コーラス・台詞の別なくユニットのメンバーまで展開して集計した一覧。
     ・歌手タブ：人物名義で参加した人（初参加順）。コーラスだけで参加した人は「コーラスのみ」セクションに分ける。
     ・キャラクタータブ：キャラ × 声優の組。最初に歌った録音のシリーズごとに見出しを立てる。
     ・初参加順 / 参加曲数が多い順タブ：人物単位（キャラとしての参加は声優の参加として合算）。
     ・タブ切替はスタッフ一覧と同じインライン JS。 ##}}
<div class="creators-root creators-tabs products-tabs">
  <div class="tabs" role="tablist" aria-label="歌唱一覧の切り替え">
    <button type="button" class="tab-btn is-active" data-tab="singers"
            role="tab" aria-selected="true" aria-controls="singers-tab-panel-singers">
      歌手
    </button>
    <button type="button" class="tab-btn" data-tab="characters"
            role="tab" aria-selected="false" aria-controls="singers-tab-panel-characters">
      キャラクター
    </button>
    <button type="button" class="tab-btn" data-tab="debut"
            role="tab" aria-selected="false" aria-controls="singers-tab-panel-debut">
      初参加順
    </button>
    <button type="button" class="tab-btn" data-tab="count"
            role="tab" aria-selected="false" aria-controls="singers-tab-panel-count">
      参加曲数が多い順
    </button>
  </div>

  {{## ──────── 歌手パネル（既定）。ボーカル（歌・台詞で参加）とコーラスのみの 2 セクション ──────── ##}}
  <div class="tab-panel is-active" id="singers-tab-panel-singers"
       data-tab-panel="singers" role="tabpanel">
    {{~ if (array.size SingerSections) == 0 ~}}
    <p class="empty-row">ご本人の名義での歌唱はまだ登録されていません。</p>
    {{~ else ~}}
    {{~ for sec in SingerSections ~}}
    <section class="creators-series-section">
      <h2 class="creators-series-heading">{{ sec.Label | html.escape }}</h2>
      <ul class="entity-list">
        {{~ for e in sec.Rows ~}}
        <li class="entity-row">
          <a class="entity-row-name" href="{{ e.PersonUrl }}">{{ e.PersonName | html.escape }}</a>
          {{~ if e.DebutSongTitle != "" ~}}<span class="entity-row-sub muted">初参加：<a href="{{ e.DebutSongUrl }}">{{ e.DebutSongTitle | html.escape }}</a></span>{{~ end ~}}
          <span class="entity-row-count"><span class="count-badges"><span class="count-pill count-pill-song">🎵 {{ e.SongCount }}</span></span></span>
        </li>
        {{~ end ~}}
      </ul>
    </section>
    {{~ end ~}}
    {{~ end ~}}
  </div>

  {{## ──────── キャラクターパネル ──────── ##}}
  <div class="tab-panel" id="singers-tab-panel-characters"
       data-tab-panel="characters" role="tabpanel" hidden>
    {{~ if (array.size CharacterSections) == 0 ~}}
    <p class="empty-row">キャラクターとしての歌唱はまだ登録されていません。</p>
    {{~ else ~}}
    {{~ for sec in CharacterSections ~}}
    <section class="creators-series-section">
      <h2 class="creators-series-heading">{{~ if sec.SeriesUrl != "" ~}}<a href="{{ sec.SeriesUrl }}">{{ sec.SeriesTitle | html.escape }}</a>{{~ else ~}}{{ sec.SeriesTitle | html.escape }}{{~ end ~}}</h2>
      <ul class="entity-list">
        {{~ for c in sec.Rows ~}}
        <li class="entity-row">
          <a class="entity-row-name" href="{{ c.CharacterUrl }}">{{ c.CharacterName | html.escape }}</a>
          <span class="entity-row-sub muted">CV: <a href="{{ c.VoiceUrl }}">{{ c.VoiceName | html.escape }}</a></span>
          <span class="entity-row-count"><span class="count-badges"><span class="count-pill count-pill-song">🎵 {{ c.SongCount }}</span></span></span>
        </li>
        {{~ end ~}}
      </ul>
    </section>
    {{~ end ~}}
    {{~ end ~}}
  </div>

  {{## ──────── 初参加順パネル ──────── ##}}
  <div class="tab-panel" id="singers-tab-panel-debut"
       data-tab-panel="debut" role="tabpanel" hidden>
    {{~ if (array.size DebutSections) == 0 ~}}
    <p class="empty-row">歌唱情報はまだ登録されていません。</p>
    {{~ else ~}}
    {{## 初参加の録音の出典シリーズごとのセクション（スタッフ一覧・声の出演一覧の初参加順と同じ「シリーズ名（年）」見出し）。 ##}}
    {{~ for sec in DebutSections ~}}
    <section class="creators-series-section">
      <h2 class="creators-series-heading">{{~ if sec.SeriesUrl != "" ~}}<a href="{{ sec.SeriesUrl }}">{{ sec.SeriesHeadingLabel | html.escape }}</a>{{~ else ~}}{{ sec.SeriesHeadingLabel | html.escape }}{{~ end ~}}</h2>
      <ul class="entity-list">
        {{~ for e in sec.Members ~}}
        <li class="entity-row">
          <a class="entity-row-name" href="{{ e.PersonUrl }}">{{ e.PersonName | html.escape }}</a>
          {{~ if e.DebutSongTitle != "" ~}}<span class="entity-row-sub muted">初参加：<a href="{{ e.DebutSongUrl }}">{{ e.DebutSongTitle | html.escape }}</a></span>{{~ end ~}}
          <span class="entity-row-count"><span class="count-badges"><span class="count-pill count-pill-song">🎵 {{ e.SongCount }}</span></span></span>
        </li>
        {{~ end ~}}
      </ul>
    </section>
    {{~ end ~}}
    {{~ end ~}}
  </div>

  {{## ──────── 参加曲数が多い順パネル ──────── ##}}
  <div class="tab-panel" id="singers-tab-panel-count"
       data-tab-panel="count" role="tabpanel" hidden>
    {{~ if (array.size CountRows) == 0 ~}}
    <p class="empty-row">歌唱情報はまだ登録されていません。</p>
    {{~ else ~}}
    <ul class="entity-list entity-list-grid">
      {{~ for e in CountRows ~}}
      <li class="entity-row">
        <a class="entity-row-link" href="{{ e.PersonUrl }}" aria-label="{{ e.PersonName | html.escape }}"></a>
        <a class="entity-row-name" href="{{ e.PersonUrl }}">{{ e.PersonName | html.escape }}</a>
        <span class="entity-row-count"><span class="count-badges"><span class="count-pill count-pill-song">🎵 {{ e.SongCount }}</span></span></span>
      </li>
      {{~ end ~}}
    </ul>
    {{~ end ~}}
  </div>
</div>

<script>
(function () {
  var root = document.querySelector('.creators-tabs');
  if (!root) return;

  var buttons = root.querySelectorAll('.tab-btn');
  var panels  = root.querySelectorAll('.tab-panel');
  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var key = btn.getAttribute('data-tab');
      buttons.forEach(function (b) {
        var active = b.getAttribute('data-tab') === key;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      panels.forEach(function (p) {
        var active = p.getAttribute('data-tab-panel') === key;
        p.classList.toggle('is-active', active);
        if (active) { p.removeAttribute('hidden'); } else { p.setAttribute('hidden', ''); }
      });
    });
  });
})();
</script>
