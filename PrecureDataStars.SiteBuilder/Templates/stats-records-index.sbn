{{## /stats/records/ — 歴代記録。
     RecordsGenerator から RecordsIndexModel { Groups } で渡る。
     Groups は大分類（本編の尺 / 1 話のクレジット / スタッフ・声優 / キャラクター）。分類ごとに基準点ラベル（尺はパート情報、
     1 話のクレジット・スタッフ・キャラクターはクレジットの収録範囲）を h2 の下に出す。
     本編の尺と 1 話のクレジットは対の組（RecordPair。長い回と短い回、早い回と遅い回、多い回と少ない回）を 1 つの枠の左右に並べ、それぞれ 1 位を
     大きい数字で、2 位・3 位を小さい行で出す（同率 1 位は全件を大きく出す）。
     スタッフ・声優とキャラクターは項目（RecordItem）ごとの枠で、数を 1 位に対する棒の長さで比べる。 ##}}
{{~ func record_side(it, kind) ~}}
    <div class="rec-side rec-side-{{ kind }}" id="{{ it.Id }}">
      <p class="rec-kind">{{ it.Title | html.escape }}</p>
      {{~ if (array.size it.Entries) > 0 ~}}
      {{~ for e in it.Tops ~}}
      <div class="rec-top">
        <span class="rec-rank">{{ e.RankLabel }}</span>
        <span class="rec-top-body">
          <span class="rec-top-name">{{ e.NameHtml }}</span>
          {{~ if e.SubHtml != "" ~}}<span class="rec-sub">{{ e.SubHtml }}</span>{{~ end ~}}
        </span>
        <span class="rec-top-value">{{ e.ValueNumber | html.escape }}{{~ if e.ValueUnit != "" ~}}<span class="rec-unit">{{ e.ValueUnit | html.escape }}</span>{{~ end ~}}</span>
      </div>
      {{~ end ~}}
      {{~ if (array.size it.Rest) > 0 ~}}
      <ol class="rec-rest">
        {{~ for e in it.Rest ~}}
        <li>
          <span class="rec-rank">{{ e.RankLabel }}</span>
          <span class="rec-body">
            <span class="rec-name">{{ e.NameHtml }}</span>
            {{~ if e.SubHtml != "" ~}}<span class="rec-sub">{{ e.SubHtml }}</span>{{~ end ~}}
          </span>
          <span class="rec-value">{{ e.ValueLabel | html.escape }}</span>
        </li>
        {{~ end ~}}
      </ol>
      {{~ end ~}}
      {{~ else ~}}
      <p class="muted rec-empty">まだ記録がありません。</p>
      {{~ end ~}}
      {{~ if it.MoreUrl != "" ~}}
      <p class="rec-more"><a href="{{ it.MoreUrl }}">{{ it.MoreLabel | html.escape }}</a></p>
      {{~ end ~}}
    </div>
{{~ end ~}}
<section>
  <h1>歴代記録</h1>
  <p class="lead">最長・最短・最多・最少の上位 3 位</p>
  <p class="muted stats-note">順位は同じ値を同じ順位とし、3 位まで載せています。</p>
</section>

{{~ for g in Groups ~}}
<section id="{{ g.Id }}">
  <h2>{{ g.Title | html.escape }}</h2>
  {{~ if g.Lead != "" ~}}
  <p>{{ g.Lead | html.escape }}<br>
  <span class="muted stats-coverage">{{ g.CoverageLabel }}</span></p>
  {{~ end ~}}
  {{~ if (array.size g.Pairs) > 0 ~}}
  <div class="rec-list">
    {{~ for p in g.Pairs ~}}
    <article class="rec rec-pair">
      <h3 class="rec-title">{{ p.Title | html.escape }}</h3>
      <div class="rec-sides">
{{ record_side p.High "high" }}
{{ record_side p.Low "low" }}
      </div>
    </article>
    {{~ end ~}}
  </div>
  {{~ end ~}}
  {{~ if (array.size g.Items) > 0 ~}}
  <div class="rec-grid">
    {{~ for it in g.Items ~}}
    <article class="rec" id="{{ it.Id }}">
      <h3 class="rec-title">{{ it.Title | html.escape }}</h3>
      {{~ if (array.size it.Entries) > 0 ~}}
      <ol class="rec-bars">
        {{~ for e in it.Entries ~}}
        <li{{ if e.RankLabel == "1" }} class="is-top"{{ end }}>
          <span class="rec-rank">{{ e.RankLabel }}</span>
          <span class="rec-body">
            <span class="rec-name">{{ e.NameHtml }}</span>
            {{~ if e.SubHtml != "" ~}}<span class="rec-sub">{{ e.SubHtml }}</span>{{~ end ~}}
          </span>
          <span class="rec-value">{{ e.ValueNumber | html.escape }}<span class="rec-unit">{{ e.ValueUnit | html.escape }}</span></span>
          <span class="rec-bar"><span style="width: {{ e.BarPercent }}%"></span></span>
        </li>
        {{~ end ~}}
      </ol>
      {{~ else ~}}
      <p class="muted rec-empty">まだ記録がありません。</p>
      {{~ end ~}}
      {{~ if it.MoreUrl != "" ~}}
      <p class="rec-more"><a href="{{ it.MoreUrl }}">{{ it.MoreLabel | html.escape }}</a></p>
      {{~ end ~}}
    </article>
    {{~ end ~}}
  </div>
  {{~ end ~}}
</section>
{{~ end ~}}
