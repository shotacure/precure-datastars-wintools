<h1>歴代プリキュア歌唱</h1>

<p class="lead">
  プリキュアの主題歌・挿入歌・キャラクターソングを歌った人々の記録。
<br>
  <span class="muted stats-coverage">{{ CoverageLabel }}</span>
</p>

{{## 歌唱。録音の歌唱者（song_recording_singers）を、歌・コーラス・台詞の別なくユニットのメンバーまで展開して集計した一覧。
     ・歌手（人物単位。本人名義での参加）とキャラクター（キャラ × 声優の組）の行を 1 つのリストに並べ、
       行頭のアイコン（歌手 = 人 / キャラクター = 星）で区別する。キャラクターの行は「キャラ名(CV: 声優)」。
     ・初参加順タブ：初参加の録音の出典シリーズごとのセクション。参加曲数順タブ：曲数の多い順。
       年表タブ：参加の移り変わりの線表（行は一覧と同じ data-entity-type を持ち、絞り込みが線表の行にも効く）。
     ・タブの下の絞り込み（すべて / 歌手のみ / キャラクターのみ）はルートの data-entity-filter を書き換え、
       行の出し分けは site.css 側のセレクタが解決する。絞り込みで行が無くなったシリーズ見出しは JS で隠す。
     ・タブ切替はスタッフ一覧と同じインライン JS。 ##}}
<div class="creators-root creators-tabs products-tabs" data-entity-filter="all">
  <div class="tabs" role="tablist" aria-label="歌唱一覧の並べ替え">
    <button type="button" class="tab-btn is-active" data-tab="debut"
            role="tab" aria-selected="true" aria-controls="singers-tab-panel-debut">
      初参加順
    </button>
    <button type="button" class="tab-btn" data-tab="count"
            role="tab" aria-selected="false" aria-controls="singers-tab-panel-count">
      参加曲数順
    </button>
    {{~ if Timeline ~}}
    <button type="button" class="tab-btn" data-tab="timeline"
            role="tab" aria-selected="false" aria-controls="singers-tab-panel-timeline">
      年表
    </button>
    {{~ end ~}}
  </div>

  <div class="list-toolbar">
  <div class="entity-filter" role="group" aria-label="歌手・キャラクターで絞り込み">
    <button type="button" class="entity-filter-btn is-active" data-entity-filter-set="all">すべて</button>
    <button type="button" class="entity-filter-btn" data-entity-filter-set="singer">歌手のみ</button>
    <button type="button" class="entity-filter-btn" data-entity-filter-set="character">キャラクターのみ</button>
  </div>
  {{## 件数での並べ替えボタン（count-sort.js）。data-count-sort-for のリストの行を、件数バッジの種類ごとに多い順／少ない順で並べ替える。対象リストが出ているときだけ表示される。 ##}}
  <button type="button" class="count-sort-btn" data-count-sort-for="singers-count-list" hidden></button>
  </div>

  {{## ──────── 初参加順パネル（既定） ──────── ##}}
  <div class="tab-panel is-active" id="singers-tab-panel-debut"
       data-tab-panel="debut" role="tabpanel">
    {{~ if (array.size DebutSections) == 0 ~}}
    <p class="empty-row">歌唱情報はまだ登録されていません。</p>
    {{~ else ~}}
    {{## 初参加の録音の出典シリーズごとのセクション（スタッフ一覧・声の出演一覧の初参加順と同じ「シリーズ名（年）」見出し）。 ##}}
    {{~ for sec in DebutSections ~}}
    <section class="creators-series-section">
      <h2 class="creators-series-heading">{{~ if sec.SeriesUrl != "" ~}}<a href="{{ sec.SeriesUrl }}">{{ sec.SeriesHeadingLabel | html.escape }}</a>{{~ else ~}}{{ sec.SeriesHeadingLabel | html.escape }}{{~ end ~}}</h2>
      <ul class="entity-list">
        {{~ for e in sec.Members ~}}
        <li class="entity-row" data-entity-type="{{ e.EntityKind }}">
          {{~ if e.EntityKind == "singer" ~}}<span class="entity-badge entity-badge-person" aria-label="歌手" title="歌手"><svg class="entity-badge-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="5" r="3"/><path d="M2 14.5a6 6 0 0 1 12 0z"/></svg></span>
          {{~ else ~}}<span class="entity-badge entity-badge-character" aria-label="キャラクター" title="キャラクター"><svg class="entity-badge-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 1.2l2 4.3 4.7.5-3.5 3.2 1 4.6L8 11.4l-4.2 2.4 1-4.6L1.3 6l4.7-.5z"/></svg></span>{{~ end ~}}
          <a class="entity-row-name" href="{{ e.Url }}">{{ e.Name | html.escape }}</a>{{~ if e.VoiceName != "" ~}}<span class="entity-row-cv">(CV: <a href="{{ e.VoiceUrl }}">{{ e.VoiceName | html.escape }}</a>)</span>{{~ end ~}}
          {{~ if e.DebutSongTitle != "" ~}}<span class="entity-row-sub muted">初参加：<a href="{{ e.DebutSongUrl }}">{{ e.DebutSongTitle | html.escape }}</a></span>{{~ end ~}}
          <span class="entity-row-count"><span class="count-badges"><span class="count-pill count-pill-song">🎵 {{ e.SongCount }}</span></span></span>
        </li>
        {{~ end ~}}
      </ul>
    </section>
    {{~ end ~}}
    {{~ end ~}}
  </div>

  {{## ──────── 参加曲数順パネル ──────── ##}}
  <div class="tab-panel" id="singers-tab-panel-count"
       data-tab-panel="count" role="tabpanel" hidden>
    {{~ if (array.size CountRows) == 0 ~}}
    <p class="empty-row">歌唱情報はまだ登録されていません。</p>
    {{~ else ~}}
    <ul class="entity-list" id="singers-count-list">
      {{~ for e in CountRows ~}}
      <li class="entity-row" data-entity-type="{{ e.EntityKind }}">
        {{~ if e.EntityKind == "singer" ~}}<span class="entity-badge entity-badge-person" aria-label="歌手" title="歌手"><svg class="entity-badge-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="5" r="3"/><path d="M2 14.5a6 6 0 0 1 12 0z"/></svg></span>
        {{~ else ~}}<span class="entity-badge entity-badge-character" aria-label="キャラクター" title="キャラクター"><svg class="entity-badge-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 1.2l2 4.3 4.7.5-3.5 3.2 1 4.6L8 11.4l-4.2 2.4 1-4.6L1.3 6l4.7-.5z"/></svg></span>{{~ end ~}}
        <a class="entity-row-name" href="{{ e.Url }}">{{ e.Name | html.escape }}</a>{{~ if e.VoiceName != "" ~}}<span class="entity-row-cv">(CV: <a href="{{ e.VoiceUrl }}">{{ e.VoiceName | html.escape }}</a>)</span>{{~ end ~}}
        <span class="entity-row-count"><span class="count-badges"><span class="count-pill count-pill-song">🎵 {{ e.SongCount }}</span></span></span>
      </li>
      {{~ end ~}}
    </ul>
    {{~ end ~}}
  </div>

  {{## ──────── 年表パネル（参加の移り変わりの線表。中身は _role-timeline.sbn） ──────── ##}}
  {{~ if Timeline ~}}
  <div class="tab-panel" id="singers-tab-panel-timeline"
       data-tab-panel="timeline" role="tabpanel" hidden>
    {{ include '_role-timeline.sbn' }}
  </div>
  {{~ end ~}}
</div>

<script>
(function () {
  var root = document.querySelector('.creators-tabs');
  if (!root) return;

  var buttons = root.querySelectorAll('.tab-btn');
  var panels  = root.querySelectorAll('.tab-panel');
  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var key = btn.getAttribute('data-tab');
      buttons.forEach(function (b) {
        var active = b.getAttribute('data-tab') === key;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      panels.forEach(function (p) {
        var active = p.getAttribute('data-tab-panel') === key;
        p.classList.toggle('is-active', active);
        if (active) { p.removeAttribute('hidden'); } else { p.setAttribute('hidden', ''); }
      });
    });
  });

  // 歌手 / キャラクターの絞り込み。行の出し分けは CSS、行が無くなったシリーズ見出しはここで隠す。
  var filterButtons = root.querySelectorAll('.entity-filter-btn');
  filterButtons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var mode = btn.getAttribute('data-entity-filter-set');
      root.setAttribute('data-entity-filter', mode);
      filterButtons.forEach(function (b) { b.classList.toggle('is-active', b === btn); });
      root.querySelectorAll('.creators-series-section').forEach(function (sec) {
        var visible = mode === 'all' || sec.querySelector('[data-entity-type="' + mode + '"]');
        if (visible) { sec.removeAttribute('hidden'); } else { sec.setAttribute('hidden', ''); }
      });
    });
  });
})();
</script>
