<p class="muted">
  <a href="/creators/music-production/">音楽制作</a>{{~ if GroupLabel != "" ~}} ／ {{ GroupLabel | html.escape }}{{~ end ~}}
</p>

<h1>{{ RoleNameJa | html.escape }}</h1>
<p class="muted page-coverage">{{ CoverageLabel }}</p>

{{## 音楽クレジット（music_credits、ストリングス編曲は song_credits）の役職 1 つ分。
     ・1 行 = 人物または団体のアコーディオン（details）。閉じた状態は名前と件数（劇伴の TV 作品数 📺・映画本数 🎥、歌の曲数 🎵、盤の点数 💿）。
       開くと担当先を「劇伴（1 作品 1 行、録音回を添える）/ 歌（曲・録音ごとに 1 行）/ 盤」に分けて並べる。
     ・ほかの役職詳細と同じタブ（初担当順（この役職で初めて担当した作品ごとのセクション）/ 参加数順 / 年表）で切り替える。
       「年表」は、担当先を時期に置いた線表（一覧の全員。中身は _role-timeline.sbn）。
       パラメータ付き include は使わない方針なので、行の中身は両方の並びに直接展開する。 ##}}
{{~ if (array.size CountRows) == 0 ~}}
<p class="empty-row">この役職の担当者情報はまだ登録されていません。</p>
{{~ else ~}}
<div class="music-role-detail creators-root creators-tabs products-tabs">
  <div class="tabs" role="tablist" aria-label="役職別一覧の並べ替え">
    <button type="button" class="tab-btn is-active" data-tab="debut"
            role="tab" aria-selected="true" aria-controls="music-role-tab-panel-debut">
      初担当<span class="tab-sfx">順</span>
    </button>
    <button type="button" class="tab-btn" data-tab="count"
            role="tab" aria-selected="false" aria-controls="music-role-tab-panel-count">
      参加数<span class="tab-sfx">順</span>
    </button>
    {{~ if Timeline ~}}
    <button type="button" class="tab-btn" data-tab="timeline"
            role="tab" aria-selected="false" aria-controls="music-role-tab-panel-timeline">
      年表
    </button>
    {{~ end ~}}
  </div>
  <div class="list-toolbar">
  {{## 件数での並べ替えボタン（count-sort.js）。data-count-sort-for のリストの行を、件数バッジの種類ごとに多い順／少ない順で並べ替える。対象リストが出ているときだけ表示される。 ##}}
  <button type="button" class="count-sort-btn" data-count-sort-for="music-role-count-list" hidden></button>
  </div>

  <div class="tab-panel is-active" id="music-role-tab-panel-debut"
       data-tab-panel="debut" role="tabpanel">
    {{~ for sec in DebutSections ~}}
    <section class="creators-series-section" id="debut-{{ for.index + 1 }}"
             data-section-nav-label="{{ (nav_main sec.SeriesTitle) | html.escape }}"
             data-section-nav-prefix="{{ (nav_prefix sec.SeriesTitle) | html.escape }}"
             data-section-nav-title="{{ sec.SeriesTitle | html.escape }}"
             data-section-nav-year="{{ sec.SeriesYearLabel }}"
             data-section-nav-count="{{ array.size sec.Members }}">
      <h2 class="creators-series-heading">{{~ if sec.SeriesUrl != "" ~}}<a href="{{ sec.SeriesUrl }}">{{ sec.SeriesHeadingLabel | html.escape }}</a>{{~ else ~}}{{ sec.SeriesHeadingLabel | html.escape }}{{~ end ~}}</h2>
      <ul class="entity-list music-role-member-list">
        {{~ for e in sec.Members ~}}
        <li>
          <details class="music-role-member">
            <summary>
              <a class="entity-row-name" href="{{ e.Url }}">{{ e.Name | html.escape }}</a>
              <span class="entity-row-count"><span class="count-badges">{{~ if e.TvWorkCount > 0 ~}}<span class="count-pill count-pill-tv" title="劇伴 TVシリーズ {{ e.TvWorkCount }} 作品">📺 {{ e.TvWorkCount }}</span>{{~ end ~}}{{~ if e.MovieWorkCount > 0 ~}}<span class="count-pill count-pill-movie" title="劇伴 映画 {{ e.MovieWorkCount }} 本">🎥 {{ e.MovieWorkCount }}</span>{{~ end ~}}{{~ if e.SongCount > 0 ~}}<span class="count-pill count-pill-song" title="歌 {{ e.SongCount }} 曲">🎵 {{ e.SongCount }}</span>{{~ end ~}}{{~ if e.ProductCount > 0 ~}}<span class="count-pill count-pill-cd" title="音盤 {{ e.ProductCount }} 点">💿 {{ e.ProductCount }}</span>{{~ end ~}}</span></span>
            </summary>
            <div class="music-role-member-body">
              {{~ if (array.size e.BgmItems) > 0 ~}}
              <div class="music-role-member-kind">劇伴</div>
              <ul class="music-role-member-items">
                {{~ for t in e.BgmItems ~}}
                <li><a href="{{ t.Url }}">{{ t.Title | html.escape }}</a>{{~ if t.Sub != "" ~}}<span class="muted">（{{ t.Sub | html.escape }}）</span>{{~ end ~}}</li>
                {{~ end ~}}
              </ul>
              {{~ end ~}}
              {{~ if (array.size e.SongItems) > 0 ~}}
              <div class="music-role-member-kind">歌</div>
              <ul class="music-role-member-items">
                {{~ for t in e.SongItems ~}}
                <li><a href="{{ t.Url }}">{{ t.Title | html.escape }}</a></li>
                {{~ end ~}}
              </ul>
              {{~ end ~}}
              {{~ if (array.size e.ProductItems) > 0 ~}}
              <div class="music-role-member-kind">盤</div>
              <ul class="music-role-member-items">
                {{~ for t in e.ProductItems ~}}
                <li><a href="{{ t.Url }}">{{ t.Title | html.escape }}</a></li>
                {{~ end ~}}
              </ul>
              {{~ end ~}}
            </div>
          </details>
        </li>
        {{~ end ~}}
      </ul>
    </section>
    {{~ end ~}}
  </div>

  <div class="tab-panel" id="music-role-tab-panel-count"
       data-tab-panel="count" role="tabpanel" hidden>
  <ul class="entity-list music-role-member-list" id="music-role-count-list">
    {{~ for e in CountRows ~}}
    <li>
      <details class="music-role-member">
        <summary>
          <a class="entity-row-name" href="{{ e.Url }}">{{ e.Name | html.escape }}</a>
          <span class="entity-row-count"><span class="count-badges">{{~ if e.TvWorkCount > 0 ~}}<span class="count-pill count-pill-tv" title="劇伴 TVシリーズ {{ e.TvWorkCount }} 作品">📺 {{ e.TvWorkCount }}</span>{{~ end ~}}{{~ if e.MovieWorkCount > 0 ~}}<span class="count-pill count-pill-movie" title="劇伴 映画 {{ e.MovieWorkCount }} 本">🎥 {{ e.MovieWorkCount }}</span>{{~ end ~}}{{~ if e.SongCount > 0 ~}}<span class="count-pill count-pill-song" title="歌 {{ e.SongCount }} 曲">🎵 {{ e.SongCount }}</span>{{~ end ~}}{{~ if e.ProductCount > 0 ~}}<span class="count-pill count-pill-cd" title="音盤 {{ e.ProductCount }} 点">💿 {{ e.ProductCount }}</span>{{~ end ~}}</span></span>
        </summary>
        <div class="music-role-member-body">
          {{~ if (array.size e.BgmItems) > 0 ~}}
          <div class="music-role-member-kind">劇伴</div>
          <ul class="music-role-member-items">
            {{~ for t in e.BgmItems ~}}
            <li><a href="{{ t.Url }}">{{ t.Title | html.escape }}</a>{{~ if t.Sub != "" ~}}<span class="muted">（{{ t.Sub | html.escape }}）</span>{{~ end ~}}</li>
            {{~ end ~}}
          </ul>
          {{~ end ~}}
          {{~ if (array.size e.SongItems) > 0 ~}}
          <div class="music-role-member-kind">歌</div>
          <ul class="music-role-member-items">
            {{~ for t in e.SongItems ~}}
            <li><a href="{{ t.Url }}">{{ t.Title | html.escape }}</a></li>
            {{~ end ~}}
          </ul>
          {{~ end ~}}
          {{~ if (array.size e.ProductItems) > 0 ~}}
          <div class="music-role-member-kind">盤</div>
          <ul class="music-role-member-items">
            {{~ for t in e.ProductItems ~}}
            <li><a href="{{ t.Url }}">{{ t.Title | html.escape }}</a></li>
            {{~ end ~}}
          </ul>
          {{~ end ~}}
        </div>
      </details>
    </li>
    {{~ end ~}}
  </ul>
  </div>

  {{~ if Timeline ~}}
  <div class="tab-panel" id="music-role-tab-panel-timeline"
       data-tab-panel="timeline" role="tabpanel" hidden>
    {{ include '_role-timeline.sbn' }}
  </div>
  {{~ end ~}}
</div>

<script>
(function () {
  // タブの切り替え（ほかの役職詳細と同じ。同じ枠の中の .tab-panel を出し分ける）。
  var root = document.querySelector('.music-role-detail');
  if (!root) return;
  var buttons = root.querySelectorAll('.tab-btn');
  var panels  = root.querySelectorAll('.tab-panel');
  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var key = btn.getAttribute('data-tab');
      root.setAttribute('data-active-tab', key);
      buttons.forEach(function (b) {
        var active = b.getAttribute('data-tab') === key;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      panels.forEach(function (p) {
        var active = p.getAttribute('data-tab-panel') === key;
        p.classList.toggle('is-active', active);
        if (active) { p.removeAttribute('hidden'); } else { p.setAttribute('hidden', ''); }
      });
    });
  });
})();
</script>
{{~ end ~}}
