<h1>歴代プリキュア音楽商品(CD/配信)</h1>

<p class="lead">
  サウンドトラックから主題歌シングルまで、歴代プリキュアの音楽商品(CD/配信)を全 {{ TotalCount }} 件そろえました。発売日や収録曲から、お探しの一枚を見つけてください。
</p>

{{## 商品索引にシリーズ別／ジャンル別の 2 タブを導入。
     ・既定タブは「シリーズ別」発売順。各セクション内は発売日昇順・代表品番昇順。
     ・「シリーズ別」では、商品の全ディスクが同一シリーズに紐付くならそのシリーズのセクションへ入れる。
       単一のシリーズに紐付かない商品（=ディスクで複数シリーズに分かれる／ディスクで 1 件も
       シリーズ紐付けが無い／ディスクが未登録）は、シリーズセクション末尾に商品種別
       （product_kinds.display_order 昇順、見出しは product_kinds.name_ja）の
       サブセクションとして並べる（バケット振り分けは Generator 側）。
     ・JS 無効時は既定タブ（シリーズ別）のパネルのみが見える状態に落ちる。タブ切替は
       小さなインラインスクリプトで .is-active クラスをトグルする。

     ・行の表現は楽曲索引と同型の横長カード（.products-card-list）。
       カード 1 行 = 1 商品で、上段に商品タイトル、下段（meta 行）に
       「発売日（2004.2.1 形式）／品番（複数枚商品は MJCD-20019〜21 のレンジ表記）／
        税込価格（¥3,300）／{N}枚組（複数枚商品のみ）」
     をパイプ区切りで並べ、右端に商品種別バッジを置く。 ##}}
<div class="products-tabs">
  <div class="tabs" role="tablist" aria-label="商品一覧の並べ替え">
    <button type="button" class="tab-btn is-active" data-tab="series"
            role="tab" aria-selected="true" aria-controls="products-tab-panel-series">
      シリーズ別
    </button>
    <button type="button" class="tab-btn" data-tab="kind"
            role="tab" aria-selected="false" aria-controls="products-tab-panel-kind">
      ジャンル別
    </button>
  </div>

  {{## ──────── シリーズ別パネル（既定） ──────── ##}}
  <div class="tab-panel is-active" id="products-tab-panel-series"
       data-tab-panel="series" role="tabpanel" aria-labelledby="products-tab-series">
    {{## 各シリーズセクションに id を振ってセクション内ナビ対応。
         section-nav.js はアクティブなタブパネル配下の section[id] だけを拾うので、
         シリーズ別タブを選択中は本タブのセクション一覧がそのままチップ化される。
         id プレフィックスはタブ間衝突を避けるため "prod-series-" とする。

         左サイドナビでシリーズセクションを
         「[年4桁] [件数バッジ] ○ ラベル」のレイアウトで出すため、属性を追加：
           - data-section-nav-label   ：シリーズタイトル（s.Label）のみ
           - data-section-nav-year    ：シリーズ開始年（バケット系セクションでは空）
           - data-section-nav-count   ：商品件数 ##}}
    {{~ for s in SeriesSections ~}}
    <section id="prod-series-{{ for.index + 1 }}"
             data-section-nav-label="{{ s.Label | html.escape }}"
             data-section-nav-year="{{ s.SeriesStartYearLabel }}"
             data-section-nav-count="{{ array.size s.Members }}">
      <h2>
        {{~ if s.SeriesLink != "" ~}}
        <a href="{{ s.SeriesLink }}">{{ s.Label | html.escape }}</a>
        {{~ else ~}}
        {{ s.Label | html.escape }}
        {{~ end ~}}
        {{~ if s.SeriesStartYearLabel != "" ~}}
        <span class="muted series-year">({{ s.SeriesStartYearLabel }})</span>
        {{~ end ~}}
        <span class="count-badges"><span class="count-pill count-pill-cd">💿 {{ array.size s.Members }}</span></span>
      </h2>
      {{~ if (array.size s.Members) == 0 ~}}
      <p class="empty-row">該当する商品はまだ登録されていません。</p>
      {{~ else ~}}
      <ul class="products-card-list">
        {{~ for p in s.Members ~}}
        {{## data-kind / data-sort はジャンル別タブをクライアント側で組み直すための情報。
             カード実体は本パネルにしか無く、ジャンル別タブは開かれた時点でこれらを見て複製・並べ替えする。 ##}}
        <li data-kind="{{ p.ProductKindCode | html.escape }}" data-sort="{{ p.SortKey | html.escape }}">
          <a class="products-card" href="/products/{{ p.ProductCatalogNo | html.escape }}/">
            <div class="products-card-grid">
            <div class="products-card-thumb">
              {{~ if p.CoverImageUrl != "" ~}}
              <img src="{{ p.CoverImageUrl }}" alt="" loading="lazy" decoding="async">
              {{~ else ~}}
              <span class="products-card-thumb-placeholder" aria-hidden="true"></span>
              {{~ end ~}}
            </div>
            <div class="products-card-main">
              <div class="products-card-title">{{ p.Title | html.escape }}</div>
              <div class="products-card-meta muted">
                <span class="products-card-meta-release">{{ p.ReleaseDateShort }}</span>
                <span class="products-card-meta-sep" aria-hidden="true">／</span>
                <span class="products-card-meta-catalog"><code>{{ p.CatalogNoRange | html.escape }}</code></span>
                {{~ if p.PriceIncTaxLabel != "" ~}}
                <span class="products-card-meta-sep" aria-hidden="true">／</span>
                <span class="products-card-meta-price">{{ p.PriceIncTaxLabel | html.escape }}</span>
                {{~ end ~}}
                {{~ if p.DiscCountLabel != "" ~}}
                <span class="products-card-meta-sep" aria-hidden="true">／</span>
                <span class="products-card-meta-disccount">{{ p.DiscCountLabel | html.escape }}</span>
                {{~ end ~}}
              </div>
            </div>
            <div class="products-card-badge-cell">
              {{~ if p.ProductKindLabel != "" ~}}
              <span class="products-card-badge products-card-kind-{{ p.BadgeClassSuffix }}">{{ p.ProductKindLabel | html.escape }}</span>
              {{~ end ~}}
            </div>
            </div>
          </a>
        </li>
        {{~ end ~}}
      </ul>
      {{~ end ~}}
    </section>
    {{~ end ~}}
  </div>

  {{## ──────── ジャンル別パネル ────────
       カード実体は持たない。シリーズ別パネルと同じ商品集合を並べ替えるだけなので、
       両方をサーバ描画すると全商品ぶんのカードが HTML に 2 セット入り、ページが約 1MB に膨らむ。
       本パネルはタブが最初に開かれた時点で、シリーズ別パネルのカードを複製して組み直す。
       下の JSON がグループ（ジャンル）の並びと表示名を与える設計図。
       セクション内ナビは section-nav.js が MutationObserver で再構築を拾うため、
       生成後のセクションにも data-section-nav-* を付けておく。 ##}}
  <div class="tab-panel" id="products-tab-panel-kind"
       data-tab-panel="kind" role="tabpanel" aria-labelledby="products-tab-kind" hidden></div>
  <script id="products-kind-groups" type="application/json">{{ KindGroupsJson }}</script>
</div>

{{## タブ切替のクライアントスクリプト（インライン、外部 JS を増やさない）。
     ・ボタンクリックで data-tab 属性とパネルの data-tab-panel 属性を突き合わせ、
       is-active クラスと aria-selected / hidden 属性を同期させる。
     ・スコープを products-tabs 内に閉じるため、querySelectorAll はルートから引く。 ##}}
<script>
(function () {
  var root = document.querySelector('.products-tabs');
  if (!root) return;
  var buttons = root.querySelectorAll('.tab-btn');
  var panels  = root.querySelectorAll('.tab-panel');
  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var key = btn.getAttribute('data-tab');
      buttons.forEach(function (b) {
        var active = b.getAttribute('data-tab') === key;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      panels.forEach(function (p) {
        var active = p.getAttribute('data-tab-panel') === key;
        p.classList.toggle('is-active', active);
        if (active) { p.removeAttribute('hidden'); } else { p.setAttribute('hidden', ''); }
      });
      if (key === 'kind') buildKindPanel();
    });
  });

  // ジャンル別パネルを 1 度だけ組み立てる。
  // シリーズ別パネルのカード（li[data-kind]）を複製し、ジャンルごとにまとめ直す。
  // 並びはサーバ描画時と同一：グループ順は JSON の並び、グループ内は data-sort（発売日+品番）昇順。
  var kindBuilt = false;
  function buildKindPanel() {
    if (kindBuilt) return;
    kindBuilt = true;

    var panel = root.querySelector('[data-tab-panel="kind"]');
    var dataEl = document.getElementById('products-kind-groups');
    if (!panel || !dataEl) return;

    var groups;
    try { groups = JSON.parse(dataEl.textContent); } catch (e) { return; }

    // 種別コード → カード要素の配列。
    var byKind = {};
    root.querySelectorAll('[data-tab-panel="series"] li[data-kind]').forEach(function (li) {
      var k = li.getAttribute('data-kind');
      (byKind[k] = byKind[k] || []).push(li);
    });

    var frag = document.createDocumentFragment();
    groups.forEach(function (g, i) {
      var items = byKind[g.k];
      if (!items || items.length === 0) return;
      items.sort(function (a, b) {
        var x = a.getAttribute('data-sort'), y = b.getAttribute('data-sort');
        return x < y ? -1 : (x > y ? 1 : 0);
      });

      var section = document.createElement('section');
      section.id = 'prod-kind-' + (i + 1);
      section.setAttribute('data-section-nav-label', g.l);
      section.setAttribute('data-section-nav-count', String(items.length));

      var h2 = document.createElement('h2');
      h2.appendChild(document.createTextNode(g.l));
      var badges = document.createElement('span');
      badges.className = 'count-badges';
      var pill = document.createElement('span');
      pill.className = 'count-pill count-pill-cd';
      pill.textContent = '💿 ' + items.length;
      badges.appendChild(pill);
      h2.appendChild(badges);
      section.appendChild(h2);

      var ul = document.createElement('ul');
      ul.className = 'products-card-list';
      items.forEach(function (li) {
        var clone = li.cloneNode(true);
        // ジャンル別タブでは見出し自体が商品種別を表すため、種別バッジは落とす（情報の二重提示を避ける）。
        var badgeCell = clone.querySelector('.products-card-badge-cell');
        if (badgeCell) badgeCell.parentNode.removeChild(badgeCell);
        ul.appendChild(clone);
      });
      section.appendChild(ul);
      frag.appendChild(section);
    });
    panel.appendChild(frag);
  }
})();
</script>
