<h1>歴代プリキュアオールスターズ</h1>

<p class="lead">
  初代から最新作まで、歴代の変身ヒロイン全 {{ TotalCount }} 名が勢ぞろいしています。登場順に並べた、プリキュア“オールスターズ”名鑑です。
<br>
  <span class="muted stats-coverage">{{ CoverageLabel }}</span>
</p>

{{## 2 タブ（初登場順＝既定 / 登場回数順）。タブ切替はスタッフ一覧と同じインライン JS（外部 JS を増やさない）。
     行はシリーズ詳細・声の出演と同じ行リスト表現：プリキュア名を主役（行全体クリックで
     キャラクター詳細へ）、変身前名と「(CV: 声優)」を添え書きに。CV の声優名だけは個別リンク。
     2 つのタブは行構造が同一だが、パラメータ付き include を避けて各パネルに直接展開する。 ##}}
<div class="precures-tabs products-tabs">
  <div class="tabs" role="tablist" aria-label="プリキュア一覧の並べ替え">
    <button type="button" class="tab-btn is-active" data-tab="debut"
            role="tab" aria-selected="true" aria-controls="precures-tab-panel-debut">
      初登場順
    </button>
    <button type="button" class="tab-btn" data-tab="count"
            role="tab" aria-selected="false" aria-controls="precures-tab-panel-count">
      登場回数順
    </button>
  </div>

  <div class="list-toolbar">
  {{## 件数での並べ替えボタン（count-sort.js）。data-count-sort-for のリストの行を、件数バッジの種類ごとに多い順／少ない順で並べ替える。対象リストが出ているときだけ表示される。 ##}}
  <button type="button" class="count-sort-btn" data-count-sort-for="precures-count-list" hidden></button>
  </div>

  {{## ──────── 初登場順パネル（既定・初登場シリーズごとのセクション） ──────── ##}}
  <div class="tab-panel is-active" id="precures-tab-panel-debut"
       data-tab-panel="debut" role="tabpanel">
    {{~ for s in DebutSections ~}}
    <section class="creators-series-section">
      <h2 class="creators-series-heading">
        {{~ if s.SeriesUrl != "" ~}}
        <a href="{{ s.SeriesUrl }}">{{ s.SeriesHeadingLabel | html.escape }}</a>
        {{~ else ~}}{{ s.SeriesHeadingLabel | html.escape }}{{~ end ~}}
      </h2>
      <ul class="entity-list">
        {{~ for p in s.Members ~}}
        <li class="entity-row">
          <a class="entity-row-link" href="{{ character_url p.CharacterId }}" aria-label="{{ p.TransformName | html.escape }}"></a>
          <a class="entity-row-name" href="{{ character_url p.CharacterId }}">{{ p.TransformName | html.escape }}</a>
          <span class="entity-row-sub muted">{{ p.PreTransformName | html.escape }}{{~ if p.VoiceActorName != "" ~}} (CV: {{~ if p.VoiceActorPersonId ~}}<a href="{{ person_url p.VoiceActorPersonId }}">{{ p.VoiceActorName | html.escape }}</a>{{~ else ~}}{{ p.VoiceActorName | html.escape }}{{~ end ~}}){{~ end ~}}</span>
          <span class="entity-row-count">{{~ if p.EpisodeCount > 0 || p.MovieCount > 0 ~}}<span class="count-badges">{{~ if p.EpisodeCount > 0 ~}}<span class="count-pill count-pill-tv">📺 {{ p.EpisodeCount }}</span>{{~ end ~}}{{~ if p.MovieCount > 0 ~}}<span class="count-pill count-pill-movie">🎥 {{ p.MovieCount }}</span>{{~ end ~}}</span>{{~ end ~}}</span>
        </li>
        {{~ end ~}}
      </ul>
    </section>
    {{~ end ~}}
  </div>

  {{## ──────── 登場回数順パネル（セクション無し） ──────── ##}}
  <div class="tab-panel" id="precures-tab-panel-count"
       data-tab-panel="count" role="tabpanel" hidden>
    <ul class="entity-list" id="precures-count-list">
      {{~ for p in CountRows ~}}
      <li class="entity-row">
        <a class="entity-row-link" href="{{ character_url p.CharacterId }}" aria-label="{{ p.TransformName | html.escape }}"></a>
        <a class="entity-row-name" href="{{ character_url p.CharacterId }}">{{ p.TransformName | html.escape }}</a>
        <span class="entity-row-sub muted">{{ p.PreTransformName | html.escape }}{{~ if p.VoiceActorName != "" ~}} (CV: {{~ if p.VoiceActorPersonId ~}}<a href="{{ person_url p.VoiceActorPersonId }}">{{ p.VoiceActorName | html.escape }}</a>{{~ else ~}}{{ p.VoiceActorName | html.escape }}{{~ end ~}}){{~ end ~}}</span>
        <span class="entity-row-count">{{~ if p.EpisodeCount > 0 || p.MovieCount > 0 ~}}<span class="count-badges">{{~ if p.EpisodeCount > 0 ~}}<span class="count-pill count-pill-tv">📺 {{ p.EpisodeCount }}</span>{{~ end ~}}{{~ if p.MovieCount > 0 ~}}<span class="count-pill count-pill-movie">🎥 {{ p.MovieCount }}</span>{{~ end ~}}</span>{{~ else ~}}<span class="muted">—</span>{{~ end ~}}</span>
      </li>
      {{~ end ~}}
    </ul>
  </div>
</div>

<script>
(function () {
  var root = document.querySelector('.precures-tabs');
  if (!root) return;
  var buttons = root.querySelectorAll('.tab-btn');
  var panels  = root.querySelectorAll('.tab-panel');
  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var key = btn.getAttribute('data-tab');
      buttons.forEach(function (b) {
        var active = b.getAttribute('data-tab') === key;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      panels.forEach(function (p) {
        var active = p.getAttribute('data-tab-panel') === key;
        p.classList.toggle('is-active', active);
        if (active) { p.removeAttribute('hidden'); } else { p.setAttribute('hidden', ''); }
      });
    });
  });
})();
</script>
