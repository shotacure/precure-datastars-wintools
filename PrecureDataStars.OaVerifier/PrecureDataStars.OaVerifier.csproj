<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- TS 再生エンジン。VLC ネイティブバイナリ（VideoLAN.LibVLC.Windows）を同梱して
         地デジ MPEG-2 TS（descrambled 前提）を再生する。WinForms 版は VideoView を提供。 -->
    <PackageReference Include="LibVLCSharp" />
    <PackageReference Include="LibVLCSharp.WinForms" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" />
    <!-- App.config の <connectionStrings> 読み取り用（既存 WinForms ツールと同じ）。 -->
    <PackageReference Include="System.Configuration.ConfigurationManager" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrecureDataStars.Data\PrecureDataStars.Data.csproj" />
  </ItemGroup>

</Project>
