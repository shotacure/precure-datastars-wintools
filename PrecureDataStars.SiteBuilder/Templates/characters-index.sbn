<h1>歴代キャラクター</h1>

<p class="lead">
  プリキュアたちはもちろん、妖精や敵キャラ、ゲストまで——歴代シリーズに登場する全 {{ TotalCount }} 名を、作品ごとにまとめました。「このキャラ、誰が演じてたっけ？」も、ここから調べられます。
<br>
  <span class="muted stats-coverage">{{ CoverageLabel }}</span>
</p>

{{## 2 タブ（初登場順＝既定 / 登場話数順）。タブ切替はスタッフ一覧と同じインライン JS（外部 JS を増やさない）。 ##}}
<div class="characters-tabs products-tabs">
  <div class="tabs" role="tablist" aria-label="キャラクター一覧の並べ替え">
    <button type="button" class="tab-btn is-active" data-tab="debut"
            role="tab" aria-selected="true" aria-controls="characters-tab-panel-debut">
      初登場順
    </button>
    <button type="button" class="tab-btn" data-tab="count"
            role="tab" aria-selected="false" aria-controls="characters-tab-panel-count">
      登場話数順
    </button>
  </div>

  <div class="list-toolbar">
  {{## 件数での並べ替えボタン（count-sort.js）。data-count-sort-for のリストの行を、件数バッジの種類ごとに多い順／少ない順で並べ替える。対象リストが出ているときだけ表示される。 ##}}
  <button type="button" class="count-sort-btn" data-count-sort-for="characters-count-list" hidden></button>
  </div>

  {{## ──────── 初登場順パネル（既定・シリーズ別セクション） ──────── ##}}
  <div class="tab-panel is-active" id="characters-tab-panel-debut"
       data-tab-panel="debut" role="tabpanel">
{{## 大セクション = 所属シリーズ（最早登場シリーズ）。シリーズ内は種別サブセクション（h3）。
     左サイドナビは section-nav.js が <section id="series-{n}"> を自動検出し、
     data-section-nav-label（シリーズ名）/ -year（開始年4桁）/ -count（キャラ件数）で
     「[年] [件数] ○ ラベル」を構築する。「その他（未登場）」は year 空。 ##}}
{{~ for s in Sections ~}}
<section id="series-{{ for.index + 1 }}"
         class="characters-section"
         data-section-nav-label="{{ s.SeriesTitle | html.escape }}"
         data-section-nav-year="{{ s.SeriesStartYearLabel }}"
         data-section-nav-count="{{ s.MemberCount }}">
  <h2>
    {{~ if s.SeriesSlug != "" ~}}
    <a href="/series/{{ s.SeriesSlug }}/">{{ s.SeriesTitle | html.escape }}</a>
    {{~ else ~}}
    {{ s.SeriesTitle | html.escape }}
    {{~ end ~}}
    {{~ if s.SeriesStartYearLabel != "" ~}}
    <span class="muted series-year">({{ s.SeriesStartYearLabel }})</span>
    {{~ end ~}}
    <span class="muted role-count">（{{ s.MemberCount }} 名）</span>
  </h2>
  {{~ for kg in s.KindGroups ~}}
  <h3>{{ kg.KindLabel | html.escape }}</h3>
  {{~ if (array.size kg.Members) == 0 ~}}
  <p class="empty-row">この種別のキャラクターはまだ登録されていません。</p>
  {{~ else ~}}
  {{## 名前 + 登場話数の軽い行なので、複数列詰めの entity-list-grid でコンパクトに並べる。
       読みがなは一覧では出さない（詳細ページ側にのみ掲載）。 ##}}
  <ul class="entity-list entity-list-grid">
    {{~ for c in kg.Members ~}}
    <li class="entity-row">
      <a class="entity-row-link" href="{{ character_url c.CharacterId }}" aria-label="{{ c.Name | html.escape }}"></a>
      {{~ if c.HasInvolvement ~}}
      <a class="entity-row-name" href="{{ character_url c.CharacterId }}">{{ c.Name | html.escape }}</a>
      {{~ else ~}}
      <a class="entity-row-name muted" href="{{ character_url c.CharacterId }}">{{ c.Name | html.escape }}</a>
      {{~ end ~}}
      <span class="entity-row-count">{{ if c.EpisodeCount > 0 || c.MovieCount > 0 }}<span class="count-badges">{{~ if c.EpisodeCount > 0 ~}}<span class="count-pill count-pill-tv">📺 {{ c.EpisodeCount }}</span>{{~ end ~}}{{~ if c.MovieCount > 0 ~}}<span class="count-pill count-pill-movie">🎥 {{ c.MovieCount }}</span>{{~ end ~}}</span>{{ else }}<span class="muted">—</span>{{ end }}</span>
    </li>
    {{~ end ~}}
  </ul>
  {{~ end ~}}
  {{~ end ~}}
  {{## 1 話だけ登場した単発キャラは個別ページを持たないため、種別サブセクションには並べず
       シリーズごとのゲストキャラクターページへのリンク 1 行にまとめる。 ##}}
  {{~ if s.GuestPageUrl != "" ~}}
  <h3>ゲストキャラクター</h3>
  <ul class="entity-list entity-list-grid">
    <li class="entity-row">
      <a class="entity-row-link" href="{{ s.GuestPageUrl }}" aria-label="ゲストキャラクター"></a>
      <a class="entity-row-name" href="{{ s.GuestPageUrl }}">1 話だけ登場したキャラクター</a>
      <span class="entity-row-count"><span class="count-badges"><span class="count-pill count-pill-person" title="人数"><svg class="count-pill-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="5" r="3"/><path d="M2 14.5a6 6 0 0 1 12 0z"/></svg>{{ s.GuestCount }}</span></span></span>
    </li>
  </ul>
  {{~ end ~}}
</section>
{{~ end ~}}
  </div>

  {{## ──────── 登場話数順パネル（セクション無し） ──────── ##}}
  <div class="tab-panel" id="characters-tab-panel-count"
       data-tab-panel="count" role="tabpanel" hidden>
    {{~ if (array.size CountRows) == 0 ~}}
    <p class="empty-row">登場話数のあるキャラクターはまだ登録されていません。</p>
    {{~ else ~}}
    <ul class="entity-list entity-list-grid" id="characters-count-list">
      {{~ for c in CountRows ~}}
      <li class="entity-row">
        <a class="entity-row-link" href="{{ character_url c.CharacterId }}" aria-label="{{ c.Name | html.escape }}"></a>
        <a class="entity-row-name" href="{{ character_url c.CharacterId }}">{{ c.Name | html.escape }}</a>
        <span class="entity-row-count"><span class="count-badges">{{~ if c.EpisodeCount > 0 ~}}<span class="count-pill count-pill-tv">📺 {{ c.EpisodeCount }}</span>{{~ end ~}}{{~ if c.MovieCount > 0 ~}}<span class="count-pill count-pill-movie">🎥 {{ c.MovieCount }}</span>{{~ end ~}}</span></span>
      </li>
      {{~ end ~}}
    </ul>
    {{~ end ~}}
  </div>
</div>

<script>
(function () {
  var root = document.querySelector('.characters-tabs');
  if (!root) return;
  var buttons = root.querySelectorAll('.tab-btn');
  var panels  = root.querySelectorAll('.tab-panel');
  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var key = btn.getAttribute('data-tab');
      buttons.forEach(function (b) {
        var active = b.getAttribute('data-tab') === key;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      panels.forEach(function (p) {
        var active = p.getAttribute('data-tab-panel') === key;
        p.classList.toggle('is-active', active);
        if (active) { p.removeAttribute('hidden'); } else { p.setAttribute('hidden', ''); }
      });
    });
  });
})();
</script>
